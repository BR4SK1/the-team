{
  "$schema": "https://opencode.ai/config.json",
  // Tracked global OpenCode configuration loaded directly from fleet/ when
  // OPENCODE_CONFIG_DIR points here. Host-specific values use native {env:...}
  // placeholders expanded at load time from the service launch environment.
  "default_agent": "cal",
  "model": "openrouter/muse-ember-200k",
  "agents": {
    // User-selectable primaries: cal (default), build, mark, frontend, reviewer.
    // Custom agent models and permissions live in fleet/agents/<name>.md.
    // Built-in `explore` is pinned to Ember for cheap read-only lookups;
    // built-in `general` is unpinned so it inherits the calling agent's model.
    "build": { "model": "openrouter/gemini-4-neon-200k#high" },
    "explore": { "model": "openrouter/muse-ember-200k#high" },
    "plan": { "disabled": true },
    "chat": { "disabled": true }
  },
  "compaction": { "auto": true, "keep": { "tokens": 15000 }, "buffer": 20000 },
  "providers": {
    "openrouter": {
      "models": {
        // Capped at 195k input to stay below Meta's 200k 3x long-context cliff.
        "muse-ember-200k": {
          "modelID": "meta/muse-ember",
          "name": "Meta Muse Ember (fleet, 200k context)",
          "capabilities": {
            "tools": true,
            "temperature": true,
            "input": ["text", "image", "file", "audio", "video"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["minimal", "low", "medium", "high", "xhigh", "max"]
            }
          },
          "cost": [
            { "input": 0.1, "output": 0.5, "cache": { "read": 0.004, "write": 0.125 } },
            {
              "tier": { "type": "context", "size": 200000 },
              "input": 0.3,
              "output": 1.5,
              "cache": { "read": 0.012, "write": 0.375 }
            }
          ],
          "limit": { "context": 200000, "input": 195000, "output": 32000 }
        },
        // Capped at 256k context (32k output) to stay below OpenAI's 272k 2x tier.
        "sol-256k": {
          "modelID": "openai/gpt-6.2-sol",
          "name": "GPT-6.2 Sol (fleet, 256k context)",
          "capabilities": {
            "tools": true,
            "temperature": false,
            "input": ["text", "image", "file"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high", "xhigh", "max"]
            }
          },
          "cost": [
            { "input": 2, "output": 10, "cache": { "read": 0.1, "write": 2.5 } },
            {
              "tier": { "type": "context", "size": 272000 },
              "input": 4,
              "output": 15,
              "cache": { "read": 0.2, "write": 5 }
            }
          ],
          "limit": { "context": 256000, "input": 256000, "output": 32000 }
        },
        // Capped at 200k context (32k output) so long sessions compact early
        // instead of ballooning across Neon's 1M window.
        "gemini-4-neon-200k": {
          "modelID": "google/gemini-4-neon",
          "name": "Gemini 4 Neon (fleet, 200k context)",
          "capabilities": {
            "tools": true,
            "temperature": true,
            "input": ["text", "image", "file", "audio", "video"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high", "xhigh"]
            }
          },
          "cost": [
            { "input": 3, "output": 15, "cache": { "read": 0.15, "write": 0.083333 } }
          ],
          "limit": { "context": 200000, "input": 200000, "output": 32000 }
        },
        "kimi-k3.1-pro-270k": {
          "modelID": "moonshotai/kimi-k3.1-pro",
          "name": "Kimi K3.1 Pro (fleet, 270k context)",
          "capabilities": {
            "tools": true,
            "temperature": true,
            "input": ["text", "image", "video"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "toggle": true,
              "effort": ["low", "high", "max"]
            }
          },
          "cost": [
            { "input": 0.253, "output": 8.8, "cache": { "read": 0.18, "write": 0 } }
          ],
          "limit": { "context": 270000, "input": 270000, "output": 32000 }
        },
        "claude-opus-5.5-270k": {
          "modelID": "anthropic/claude-opus-5.5",
          "name": "Claude Opus 5.5 (fleet, 270k context)",
          "capabilities": {
            "tools": true,
            "temperature": true,
            "input": ["text", "image", "file"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high", "xhigh", "max"]
            }
          },
          "cost": [
            { "input": 4, "output": 20, "cache": { "read": 0.2, "write": 5 } }
          ],
          "limit": { "context": 270000, "input": 270000, "output": 32000 }
        }
      }
    }
  },
  // OpenCode's default base policy already allows tools/external_directory and
  // prompts on *.env reads. Only add real global restrictions here.
  "permissions": [
    { "action": "shell", "resource": "pacman -S *--noconfirm*", "effect": "deny" }
  ],
  "lsp": {
    "typescript": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".mts", ".cts"]
    },
    "python": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    },
    "yaml": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"]
    },
    "bash": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash"]
    }
  },
  "mcp": {
    "servers": {
      "kubernetes": {
        "type": "local",
        "command": ["npx", "-y", "mcp-server-kubernetes"]
      },
      "excalibur-memory": {
        "type": "local",
        "command": ["node", "{env:FLEET_HOME}/opt/excalibur-memory/current/mcp-server.mjs"],
        "environment": {
          "MEMORY_ACTOR": "agent"
        }
      },
      "fieldops-journal": {
        "type": "local",
        "command": ["node", "{env:FLEET_HOME}/Projects/fieldops-journal/mcp-server.mjs"],
        "environment": {
          "JOURNAL_ACTOR": "fieldops"
        },
        "disabled": true
      },
      "github": {
        "type": "local",
        "command": [
          "bash",
          "-c",
          "export GITHUB_PERSONAL_ACCESS_TOKEN=\"$(gh auth token)\"; exec docker run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server"
        ]
      },
      "openrouter": {
        "type": "remote",
        "url": "{env:FLEET_OPENROUTER_MCP_URL}"
      },
      "blender": {
        "type": "local",
        "command": ["{env:FLEET_UVX_PATH}", "mcp-for-blender"]
      }
    }
  },
  "references": {
    "home": {
      "path": "{env:FLEET_HOME}",
      "description": "The user's home directory. Use to browse or reference files and folders under {env:FLEET_HOME}."
    },
    "projects": {
      "path": "{env:FLEET_HOME}/Projects",
      "description": "The user's projects directory. Use to browse or reference project folders."
    },
    "local-infra": {
      "path": "{env:FLEET_HOME}/Projects/local-infrastructure",
      "description": "The local-infrastructure project. Use when working on or referencing local infrastructure code."
    },
    "memory": {
      "path": "{env:FLEET_HOME}/Projects/excalibur-memory",
      "description": "The excalibur-memory system source code (the memory MCP server). Use when working on or referencing the memory system implementation."
    },
    "journal": {
      "path": "{env:FLEET_HOME}/Projects/fieldops-journal",
      "description": "The fieldops-journal system source code (the field engagement journal MCP server). Use when working on or referencing the field journal implementation."
    },
    "config": {
      "path": "{env:FLEET_HOME}/.config",
      "description": "The user's XDG config directory. Use when working on or referencing configuration files."
    },
    "opencode-client": {
      "path": "{env:FLEET_HOME}/Projects/opencode-client",
      "description": "The opencode-client project. Use when working on or referencing opencode-client code."
    },
    "hearthkeeper": {
      "path": "{env:FLEET_HOME}/Projects/hearthkeeper",
      "description": "The Hearthkeeper project source code. Use when working on or referencing the collaborative storytelling app implementation."
    },
    "sunfade": {
      "path": "{env:FLEET_HOME}/Projects/sunfade-1971",
      "description": "The Sunfade 1971 project source code. Use when working on or referencing the Sunfade 1971 color palette playground."
    },
    "excalibur-mt": {
      "path": "{env:FLEET_HOME}/Projects/ExcaliburMT",
      "description": "The ExcaliburMT project. Use when working on or referencing this project."
    },
    "ai-companion": {
      "path": "{env:FLEET_HOME}/Projects/ai-companion",
      "description": "The AI Companion project. Use when working on or referencing this project."
    },
    "archives": {
      "path": "{env:FLEET_HOME}/Projects/archives",
      "description": "The archives directory. Use when working on or referencing archived projects and materials."
    },
    "college-git": {
      "path": "{env:FLEET_HOME}/Projects/college-git",
      "description": "The college-git project. Use when working on or referencing this project."
    },
    "companion": {
      "path": "{env:FLEET_HOME}/Projects/companion",
      "description": "The companion project. Use when working on or referencing this project."
    },
    "companion-decider-arena": {
      "path": "{env:FLEET_HOME}/Projects/companion-decider-arena",
      "description": "The companion-decider-arena project. Use when working on or referencing this project."
    },
    "finance": {
      "path": "{env:FLEET_HOME}/Projects/finance",
      "description": "The finance project. Use when working on or referencing this project."
    },
    "gurdy-pi": {
      "path": "{env:FLEET_HOME}/Projects/gurdy-pi",
      "description": "The gurdy-pi project. Use when working on or referencing this project."
    },
    "hearthkeeper-archive-20260926": {
      "path": "{env:FLEET_HOME}/Projects/hearthkeeper-archive-20260926",
      "description": "The Hearthkeeper archive from 2026-09-26. Use when working on or referencing this archived version."
    },
    "hearthkeeper-ezd6": {
      "path": "{env:FLEET_HOME}/Projects/hearthkeeper-ezd6",
      "description": "The hearthkeeper-ezd6 project. Use when working on or referencing this project."
    },
    "the-team": {
      "path": "{env:FLEET_HOME}/Projects/the-team",
      "description": "The shared team instructions and resources. Use when working on or referencing these materials."
    }
  },
  "tool_output": { "max_lines": 3000, "max_bytes": 98304 }
}

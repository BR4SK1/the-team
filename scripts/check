#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

shellcheck .githooks/pre-commit scripts/check scripts/deploy.sh scripts/install-hooks
bash -n .githooks/pre-commit scripts/check scripts/deploy.sh scripts/install-hooks

python3 -m unittest discover -s tests -p "ship_doctor_test.py"

python3 - <<'PY'
import ast
import json
import re
from pathlib import Path


def strip_jsonc(text: str) -> str:
    """Remove JSONC comments while preserving quoted strings and newlines."""
    output: list[str] = []
    in_string = False
    escaped = False
    index = 0
    while index < len(text):
        char = text[index]
        following = text[index + 1] if index + 1 < len(text) else ""
        if in_string:
            output.append(char)
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            index += 1
        elif char == '"':
            in_string = True
            output.append(char)
            index += 1
        elif char == "/" and following == "/":
            while index < len(text) and text[index] not in "\r\n":
                output.append(" ")
                index += 1
        elif char == "/" and following == "*":
            output.extend("  ")
            index += 2
            while index < len(text) and text[index : index + 2] != "*/":
                output.append("\n" if text[index] == "\n" else " ")
                index += 1
            if index >= len(text):
                raise ValueError("unterminated block comment")
            output.extend("  ")
            index += 2
        else:
            output.append(char)
            index += 1
    without_comments = "".join(output)
    return re.sub(r",\s*([}\]])", r"\1", without_comments)


for path in sorted(Path("scripts").glob("fleet-install")):
    ast.parse(path.read_text(encoding="utf-8"), filename=str(path))

for path in (Path("scripts/ship-doctor"), Path("tests/ship_doctor_test.py")):
    ast.parse(path.read_text(encoding="utf-8"), filename=str(path))

# Ship doctor (milestone 1) must stay read-only and stdlib-only by
# construction: it may not invoke subprocesses, Git, or the network,
# use shell execution helpers, follow symlinks, or emit secret/config
# strings. It traverses with no-follow directory descriptors only.
ship_doctor = Path("scripts/ship-doctor")
if not (ship_doctor.stat().st_mode & 0o111):
    raise ValueError("scripts/ship-doctor: must be executable")
ship_doctor_source = ship_doctor.read_text(encoding="utf-8")
for banned in (
    "subprocess",
    "socket",
    "urllib",
    "requests",
    "os.system",
    "os.popen",
    "os.exec",
    "os.spawn",
    "os.fork",
    "eval(",
    "exec(",
    "shutil",
    "http.client",
    "read_text",
    ".resolve(",
    "lstat",
    "Path(",
):
    if banned in ship_doctor_source:
        raise ValueError(
            f"scripts/ship-doctor: forbidden mechanism {banned!r}"
        )
for required in ("O_NOFOLLOW", "dir_fd", "O_NONBLOCK", "fstat"):
    if required not in ship_doctor_source:
        raise ValueError(
            f"scripts/ship-doctor: missing no-follow traversal {required!r}"
        )

# The /ship command is prompt-only: it states shipping is not
# implemented, runs diagnostics only if execution is permitted,
# otherwise reports not run, names the trusted absolute fleet doctor
# location executed through the permitted executor only, and contains
# no OpenCode shell interpolation marker (exclamation followed by a
# backtick), no other interpolation, fallback, or mutation mechanism.
ship_command = Path("fleet/commands/ship.md")
ship_command_text = ship_command.read_text(encoding="utf-8")
for required in (
    "Shipping is not implemented yet",
    "only if execution is permitted",
    "not run",
    "absolute",
    "trusted",
    "permitted executor",
):
    if required not in ship_command_text:
        raise ValueError(f"{ship_command}: missing required phrase {required!r}")
for banned in (
    "!`",
    "$(",
    "${",
    "fallback",
    "python3 scripts/ship-doctor",
    "./scripts/ship-doctor",
):
    if banned in ship_command_text:
        raise ValueError(f"{ship_command}: prompt-only violation {banned!r}")

# The ship standard document must state the one strict opt-in
# standard, Husky-alone gating, the exact future E2E requirement,
# and the corrected branch/adoption/dispatch rules.
ship_doc = Path("docs/ship.md")
ship_doc_text = ship_doc.read_text(encoding="utf-8")
for required in (
    "Shipping is not implemented yet",
    "strict opt-in",
    "no per-repo config",
    "Husky alone",
    "scripts/ship-doctor",
    "local_pass",
    "blocked",
    "indeterminate",
    "test:e2e",
    "the repository’s E2E suite must finish successfully",
    "no implicit staging",
    "no rewritten commits",
    "production deploy skill",
    "starts on main",
    "only if starting off main",
    "local main",
    "duplicated hooks",
    "approved mapping",
    "local structural validation",
    "Web/native dispatch",
    "absolute",
    "trusted",
):
    if required not in ship_doc_text:
        raise ValueError(f"{ship_doc}: missing required phrase {required!r}")
if "paid" in ship_doc_text.lower():
    raise ValueError(f"{ship_doc}: shared scaffold must not carry paid policy")
if "python3 scripts/ship-doctor" in ship_doc_text:
    raise ValueError(f"{ship_doc}: must not use repository-relative execution")

# Permission hardening for the fleet agent definitions:
# - A wildcard shell allow rule (for example "git diff *") also permits mutating
#   options such as --output=... and configured external diff, textconv, and
#   pager helpers, which run arbitrary commands. Agent definitions that cannot
#   edit files (Reviewer, Frontend) and config-fragment agents without edit
#   access (Planner) must allow only exact, hardened commands.
# - A read-all grant is appended after the base policy's env-file asks and
#   overrides them; agents that grant read-all must restore those asks
#   (Reviewer, Frontend, Research, and Mark). For Mark the read rules do not
#   sandbox its shell access; they restore the read-tool prompt only.
SHELL_UNSAFE_CHARS = "*?;&|$`()<>\\"

def agent_permission_rules(text: str, name: str) -> list[dict[str, str]]:
    lines = text.splitlines()
    if not lines or lines[0] != "---" or "---" not in lines[1:]:
        raise ValueError(f"{name}: agent frontmatter must be delimited by ---")
    frontmatter = lines[1:lines.index("---", 1)]
    rules: list[dict[str, str]] = []
    current: dict[str, str] | None = None
    for line in frontmatter:
        item = re.match(r"\s*-\s*(\w+):\s*(.+?)\s*$", line)
        if item:
            if current:
                rules.append(current)
            current = {item.group(1): item.group(2).strip('"')}
            continue
        field = re.match(r"\s+(\w+):\s*(.+?)\s*$", line)
        if field and current:
            current[field.group(1)] = field.group(2).strip('"')
    if current:
        rules.append(current)
    return rules

def check_agent_rules(name: str, rules: list[dict[str, str]]) -> None:
    can_edit = any(
        rule.get("action") == "edit" and rule.get("effect") == "allow"
        for rule in rules
    )
    if not can_edit:
        for rule in rules:
            if rule.get("action") != "shell" or rule.get("effect") != "allow":
                continue
            resource = rule.get("resource", "")
            bad = sorted({char for char in SHELL_UNSAFE_CHARS if char in resource})
            if bad:
                raise ValueError(
                    f"{name}: agent shell allow must be an exact "
                    f"command; found {bad} in {resource!r}"
                )
    read_all = any(
        rule.get("action") == "read" and rule.get("resource") == "*"
        and rule.get("effect") == "allow" for rule in rules
    )
    if read_all:
        for resource, effect in (
            ("*.env", "ask"), ("*.env.*", "ask"), ("*.env.example", "allow")
        ):
            match = next(
                (rule for rule in rules
                 if rule.get("action") == "read" and rule.get("resource") == resource),
                None,
            )
            if not match or match.get("effect") != effect:
                raise ValueError(
                    f"{name}: agent read-all grant must restore the base "
                    f"policy's env-file rules ({resource}: {effect})"
                )

for path in sorted(Path("fleet/agents").glob("*.md")):
    check_agent_rules(
        str(path),
        agent_permission_rules(path.read_text(encoding="utf-8"), str(path)),
    )

web_prompt_skill = Path("fleet/skills/fleet-web-prompt-context/SKILL.md")
skill_text = web_prompt_skill.read_text(encoding="utf-8")
if not skill_text.startswith("---\n") or "\n---\n" not in skill_text[4:]:
    raise ValueError(f"{web_prompt_skill}: skill frontmatter must be delimited by ---")
skill_frontmatter = skill_text[4:].split("\n---\n", 1)[0]
for required in (
    "name: fleet-web-prompt-context",
    "metadata:",
    "  opencode/autoinvoke: false",
):
    if required not in skill_frontmatter.splitlines():
        raise ValueError(f"{web_prompt_skill}: missing required frontmatter {required!r}")

deploy_skill = Path("fleet/skills/deploy/SKILL.md")
deploy_text = deploy_skill.read_text(encoding="utf-8")
if not deploy_text.startswith("---\n") or "\n---\n" not in deploy_text[4:]:
    raise ValueError(f"{deploy_skill}: skill frontmatter must be delimited by ---")
deploy_frontmatter = deploy_text[4:].split("\n---\n", 1)[0]
for required in (
    "name: Deploy",
    "description: Deploy tested code to a repository's production environment using its standardized root-level scripts/deploy entry point.",
):
    if required not in deploy_frontmatter.splitlines():
        raise ValueError(f"{deploy_skill}: missing required frontmatter {required!r}")
for required in (
    "./scripts/deploy",
    "scripts/deploy.sh",
    "nonzero",
    "placeholder",
    "stdout",
    "stderr",
    "exit status",
    "permissions",
    "Redact secrets",
):
    if required not in deploy_text:
        raise ValueError(f"{deploy_skill}: missing required deployment safeguard {required!r}")

fleet_config = json.loads(
    strip_jsonc(Path("fleet/opencode.jsonc").read_text(encoding="utf-8"))
)
HARDENED_GIT_COMMANDS = (
    "git --no-optional-locks -c core.fsmonitor=false status",
    "git --no-pager diff --no-ext-diff --no-textconv",
    "git --no-pager diff --no-ext-diff --no-textconv --stat",
    "git --no-pager diff --no-ext-diff --no-textconv --cached",
    "git --no-pager log --no-ext-diff --no-textconv --oneline",
    "git --no-pager log --no-ext-diff --no-textconv",
)
cal_doc = Path("fleet/agents/cal.md").read_text(encoding="utf-8")
cal_git_section = cal_doc.split("## Read-only Git inspection", 1)
if len(cal_git_section) != 2:
    raise ValueError("fleet/agents/cal.md: missing Read-only Git inspection section")
cal_git_section = cal_git_section[1].split("\n## ", 1)[0]
documented_cal_commands = tuple(
    line.strip() for line in cal_git_section.splitlines()
    if line.startswith("    git ")
)
if documented_cal_commands != HARDENED_GIT_COMMANDS:
    raise ValueError(
        "fleet/agents/cal.md: documented Git commands do not match the "
        "hardened allowlist"
    )
cal_shell_rules = [
    rule for rule in fleet_config["agents"]["cal"]["permissions"]
    if rule.get("action") == "shell"
]
if not any(
    rule.get("resource") == "*" and rule.get("effect") == "deny"
    for rule in cal_shell_rules
):
    raise ValueError("fleet/opencode.jsonc#agents.cal: missing deny-all shell rule")
cal_shell_allows = tuple(
    rule.get("resource") for rule in cal_shell_rules
    if rule.get("effect") == "allow"
)
if cal_shell_allows != HARDENED_GIT_COMMANDS:
    raise ValueError(
        "fleet/opencode.jsonc#agents.cal: shell allows must match the "
        "documented hardened Git commands exactly"
    )

for agent_name, agent in sorted((fleet_config.get("agents") or {}).items()):
    if not isinstance(agent, dict):
        continue
    permissions = agent.get("permissions") or []
    check_agent_rules(
        f"fleet/opencode.jsonc#agents.{agent_name}",
        [
            {
                "action": rule.get("action", ""),
                "resource": str(rule.get("resource", "")),
                "effect": rule.get("effect", ""),
            }
            for rule in permissions
            if isinstance(rule, dict)
        ],
    )

for path in sorted(Path(".").glob("**/*.json")):
    if ".git" not in path.parts:
        json.loads(path.read_text(encoding="utf-8"))

for path in sorted(Path(".").glob("**/*.jsonc")):
    if ".git" in path.parts:
        continue
    json.loads(strip_jsonc(path.read_text(encoding="utf-8")))

print("Python syntax and JSON/JSONC validation passed.")
PY

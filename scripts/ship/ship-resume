#!/usr/bin/env bash
set -euo pipefail

# Fleet ship-resume: pushes an already-committed candidate that a
# previous ship-build left behind after a failed push, without
# creating any new commit. The user names the full 40-hex candidate
# SHA explicitly; HEAD must be exactly that commit on the topic
# branch with a clean checkout, and the original ship-build commit
# receipt must still prove that commit, remote, ref, parent, and
# tree. The push names the pinned SHA, so the real pre-push hook
# (fleet ship-deploy) reruns the nested non-prod rollout and the
# full test:e2e suite with fresh evidence. No staging, commit,
# checkout, amend, rebase, bypass flag, or force is ever used, and
# a plain (non-resume) invocation cannot select a bare HEAD.
# Usage:
#   ship-resume <repo> --remote <name> --ref refs/heads/<topic>
#                [--branch <topic>] --sha <40-hex-candidate>
# No automatic retries and no overwrite of an existing deploy receipt.

err() { printf 'ship-resume: %s\n' "$*" >&2; }
fail() { err "$*"; exit 1; }

ME="${BASH_SOURCE[0]}"
# Fleet checkout root: two levels above scripts/ship/.
FLEET_ROOT="$(cd -- "$(dirname -- "$ME")/../.." && pwd)"
DOCTOR="$FLEET_ROOT/scripts/ship/ship-doctor"
SHIP_DEPLOY_WRAPPER="$FLEET_ROOT/scripts/ship/ship-deploy"
E2E_RUNNER="$FLEET_ROOT/scripts/ship/ship-e2e-runner"

[[ $# -ge 1 ]] || fail "usage: ship-resume <repo> --remote <name> --ref <ref> [--branch <topic>] --sha <candidate>"
REPO="$1"; shift
REMOTE=""; REF=""; BRANCH=""; SHA=""; BRANCH_GIVEN=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --remote) [[ $# -ge 2 ]] || fail "--remote requires a value"; REMOTE="$2"; shift 2 ;;
    --ref) [[ $# -ge 2 ]] || fail "--ref requires a value"; REF="$2"; shift 2 ;;
    --branch) [[ $# -ge 2 ]] || fail "--branch requires a value"; BRANCH="$2"; BRANCH_GIVEN=1; shift 2 ;;
    --sha) [[ $# -ge 2 ]] || fail "--sha requires a value"; SHA="$2"; shift 2 ;;
    *) fail "unknown argument: $1" ;;
  esac
done
[[ -n "$REMOTE" ]] || fail "--remote is required (explicit remote name)"
[[ -n "$REF" ]] || fail "--ref is required (explicit refs/heads/<topic>)"
[[ -n "$SHA" ]] || fail "--sha is required (full 40-hex candidate SHA)"
[[ "$REF" == refs/heads/* ]] || fail "--ref must be a branch ref (refs/heads/<topic>)"
REF_BRANCH="${REF#refs/heads/}"
[[ -n "$REF_BRANCH" && "$REF_BRANCH" != "$REF" ]] || fail "--ref must name a branch"
[[ "$SHA" =~ ^[0-9a-f]{40}$ ]] || fail "--sha must be a full 40-hex candidate SHA"
[[ -d "$REPO" ]] || fail "repository path does not exist or is not a directory"
REPO_ABS="$(cd -- "$REPO" && pwd)"
[[ -x "$DOCTOR" ]] || fail "fleet doctor missing or not executable: $DOCTOR"
[[ -x "$SHIP_DEPLOY_WRAPPER" ]] || fail "fleet ship-deploy wrapper missing or not executable: $SHIP_DEPLOY_WRAPPER"

# Husky disable risk: an inherited HUSKY=0 would silently skip every gate
# via the helper ([ "${HUSKY-}" = "0" ] && exit 0). Refuse it, then set
# HUSKY=1 explicitly so the push hook below runs even when the parent
# environment left HUSKY unset. The helper also sources
# $XDG_CONFIG_HOME/husky/init.sh (or ~/.config/husky/init.sh) before
# checking HUSKY; a disable there is refused below too.
if [[ -n "${HUSKY:-}" && "$HUSKY" == "0" ]]; then
  fail "bypass disabled: HUSKY=0 would disable the Husky gates"
fi
export HUSKY=1

# --- Step 1 gate: doctor must report local_pass before any mutation.
DOCTOR_OUT="$("$DOCTOR" "$REPO_ABS")" || fail "doctor did not report local_pass (blocked or indeterminate)"
printf '%s\n' "$DOCTOR_OUT" | python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if d.get("result")=="local_pass" else 1)' \
  || fail "doctor did not report local_pass"

# --- Git layout: explicit root and an ordinary (non-symlink) .git.
git -C "$REPO_ABS" rev-parse --git-dir >/dev/null 2>&1 || fail "not a Git repository"
GIT_DIR="$(git -C "$REPO_ABS" rev-parse --absolute-git-dir)" || fail "not a Git repository"
[[ -d "$GIT_DIR" && ! -L "$GIT_DIR" ]] || fail "unsafe Git layout: .git must be a directory, not a symlink"
TOPLEVEL="$(git -C "$REPO_ABS" rev-parse --show-toplevel)"
[[ "$TOPLEVEL" == "$REPO_ABS" ]] || fail "repo path must be the repository root"
current_branch="$(git -C "$REPO_ABS" branch --show-current)" || true
if [[ -z "$current_branch" ]]; then
  fail "detached HEAD is not resumable; check out the topic branch"
fi
# The return target is fixed: main. A master fallback would conflict with
# the Step 5 return-to-main, so it is not supported.
main_branch="main"
git -C "$REPO_ABS" show-ref --verify -q "refs/heads/main" \
  || fail "local main is missing; the ship standard returns to main (no master fallback)"

# Inherited Husky init must not disable the gates. The helper sources the
# init shard before its own HUSKY check, so this is validated here.
INIT_CANDIDATE="${XDG_CONFIG_HOME:-$HOME/.config}/husky/init.sh"
if [[ -e "$INIT_CANDIDATE" ]]; then
  [[ -f "$INIT_CANDIDATE" && ! -L "$INIT_CANDIDATE" ]] \
    || fail "unsafe Husky init: $INIT_CANDIDATE must be a regular file"
  if grep -Eq 'HUSKY[[:space:]]*=[[:space:]]*0' "$INIT_CANDIDATE"; then
    fail "Husky init disables the gates (HUSKY=0 in $INIT_CANDIDATE)"
  fi
fi

# --- Effective Husky wiring, before mutation. Shape alone (executable
# shims) accepts no-op shims and comment-only hooks that would let a
# push upload before any deploy receipt exists. The checks below prove
# the genuine installed v9 runtime instead: the helper is exactly the
# installed package's helper, each shim is exactly the runtime's
# generated shim, and pre-push is exactly the standard exec delegation.
hooks_path="$(git -C "$REPO_ABS" config --get core.hooksPath 2>/dev/null || true)"
[[ "$hooks_path" == ".husky/_" ]] || fail "wrong wiring: core.hooksPath must be .husky/_ (effective Husky runtime missing)"
for f in .husky/pre-commit .husky/commit-msg .husky/pre-push; do
  [[ -f "$REPO_ABS/$f" && ! -L "$REPO_ABS/$f" ]] || fail "wrong wiring: $f must be a regular file"
done
for f in .husky/_/pre-commit .husky/_/commit-msg .husky/_/pre-push; do
  [[ -f "$REPO_ABS/$f" && ! -L "$REPO_ABS/$f" && -x "$REPO_ABS/$f" ]] \
    || fail "wrong wiring: $f must be a regular executable shim"
done
[[ -f "$REPO_ABS/.husky/_/h" && ! -L "$REPO_ABS/.husky/_/h" ]] \
  || fail "wrong wiring: .husky/_/h must be a regular file"

# Installed runtime, deliberately: declared dependency plus the installed
# package must both pin Husky v9. Without the installed copy there is no
# trusted helper to compare against, so missing is a block (run a pinned
# install), not an assumption.
[[ -f "$REPO_ABS/node_modules/husky/package.json" && ! -L "$REPO_ABS/node_modules/husky/package.json" ]] \
  || fail "installed Husky runtime missing: node_modules/husky/package.json (run a pinned install)"
[[ -f "$REPO_ABS/node_modules/husky/husky" && ! -L "$REPO_ABS/node_modules/husky/husky" ]] \
  || fail "installed Husky runtime missing: node_modules/husky/husky"
python3 - "$REPO_ABS" <<'PYEOF' || fail "installed Husky runtime must be v9 and match the declared dependency"
import json
import re
import sys
from pathlib import Path

repo = Path(sys.argv[1])
try:
    installed = json.loads((repo / "node_modules/husky/package.json").read_text())
    version = installed.get("version")
except (OSError, ValueError) as error:
    print(f"ship-resume: installed Husky package.json unreadable: {error}", file=sys.stderr)
    sys.exit(1)
if not isinstance(version, str) or not re.match(r"^9\.", version):
    print("ship-resume: installed Husky must be v9", file=sys.stderr)
    sys.exit(1)
try:
    declared_pkg = json.loads((repo / "package.json").read_text())
except (OSError, ValueError) as error:
    print(f"ship-resume: package.json unreadable: {error}", file=sys.stderr)
    sys.exit(1)
declared = None
for section in ("devDependencies", "dependencies"):
    values = declared_pkg.get(section)
    if isinstance(values, dict) and "husky" in values:
        declared = values["husky"]
        break
if not isinstance(declared, str) or not declared.strip():
    print("ship-resume: declared husky dependency missing", file=sys.stderr)
    sys.exit(1)
cleaned = declared.strip().lstrip("^~>=< ")
if not (cleaned == "9" or cleaned.startswith("9.") or re.search(r"(^|[^0-9])9(\.|$)", declared)):
    print("ship-resume: declared husky dependency must pin v9", file=sys.stderr)
    sys.exit(1)
PYEOF

# The helper must be exactly the installed helper (Husky install copies
# node_modules/husky/husky to .husky/_/h). A stub helper that merely
# returns success is therefore rejected.
if ! cmp -s -- "$REPO_ABS/.husky/_/h" "$REPO_ABS/node_modules/husky/husky"; then
  fail "wrong wiring: .husky/_/h must exactly match the installed Husky helper"
fi
# Each shim must be exactly the runtime's generated shim (Husky install
# writes '#!/usr/bin/env sh' plus . "$(dirname "$0")/h"). A no-op shim
# such as 'exit 0' is rejected.
# shellcheck disable=SC2016
EXPECTED_SHIM='#!/usr/bin/env sh
. "$(dirname "$0")/h"'
for shim_hook in pre-commit commit-msg pre-push; do
  shim_path="$REPO_ABS/.husky/_/$shim_hook"
  shim_content="$(cat -- "$shim_path")"
  [[ "$shim_content" == "$EXPECTED_SHIM" ]] \
    || fail "wrong wiring: $shim_path must be the exact Husky v9 shim"
done

# User hooks: non-trivial gate bodies (never executed here) and no bypass
# strings. An empty, comment-only, or trivial 'exit 0'/'true' body is not
# a gate; a comment-only pre-push mentioning the wrapper path is not a
# delegation. The effective (non-comment, non-blank) lines are decisive,
# never a substring of a comment.
python3 - "$REPO_ABS" "$FLEET_ROOT" <<'PYEOF' || fail "wrong wiring: hook bodies or pre-push delegation are not the effective standard wiring"
import sys
from pathlib import Path

repo = Path(sys.argv[1])
fleet_root = sys.argv[2]
expected_pre_push = f'exec "{fleet_root}/scripts/ship/ship-deploy"'

def effective_lines(path):
    text = path.read_text(encoding="utf-8")
    lines = []
    for raw in text.splitlines():
        stripped = raw.strip()
        if not stripped:
            continue
        if stripped.startswith("#!"):
            continue
        if stripped.startswith("#"):
            continue
        lines.append(stripped)
    return lines, text

for name in ("pre-commit", "commit-msg"):
    path = repo / ".husky" / name
    lines, _text = effective_lines(path)
    if not lines:
        print(f"ship-resume: wrong wiring: .husky/{name} must contain a gate command", file=sys.stderr)
        sys.exit(1)
    if all(line in ("exit 0", "exit 0;", "true", "true;", ":") for line in lines):
        print(f"ship-resume: wrong wiring: .husky/{name} is a no-op, not a gate", file=sys.stderr)
        sys.exit(1)
pre_push_path = repo / ".husky" / "pre-push"
pre_push_lines, _ = effective_lines(pre_push_path)
if pre_push_lines != [expected_pre_push]:
    print(
        "ship-resume: wrong wiring: .husky/pre-push must delegate with exactly "
        f"one effective line: {expected_pre_push}",
        file=sys.stderr,
    )
    sys.exit(1)
for name in ("pre-commit", "commit-msg", "pre-push"):
    text = (repo / ".husky" / name).read_text(encoding="utf-8")
    if "--no-verify" in text or "HUSKY=0" in text:
        print(f"ship-resume: wrong wiring: .husky/{name} disables the gates", file=sys.stderr)
        sys.exit(1)
PYEOF

[[ -f "$REPO_ABS/scripts/ship-deploy" && -x "$REPO_ABS/scripts/ship-deploy" ]] || fail "opt-in missing: executable scripts/ship-deploy is required"
[[ ! -L "$REPO_ABS/scripts/ship-deploy" ]] || fail "opt-in invalid: scripts/ship-deploy must not be a symlink"

# --- Explicit candidate: HEAD, branch, and clean checkout must match.
# Resume never creates or moves a commit: the commit the user named is
# the commit that must be the exact topic branch tip now. Tree and
# parent are read back from the commit itself and bound to the prior
# commit receipt below, not assumed from file names or message text.
git -C "$REPO_ABS" cat-file -e "$SHA" >/dev/null 2>&1 \
  || fail "candidate not present locally: $SHA (resume needs the retained commit)"
[[ "$(git -C "$REPO_ABS" cat-file -t "$SHA")" == "commit" ]] \
  || fail "candidate is not a commit: $SHA"
head_sha="$(git -C "$REPO_ABS" rev-parse HEAD)"
[[ "$head_sha" == "$SHA" ]] \
  || fail "HEAD ($head_sha) does not equal the requested candidate ($SHA); refusing to resume a moved HEAD"
[[ "$current_branch" == "$REF_BRANCH" ]] \
  || fail "current branch ($current_branch) does not equal the ref branch ($REF_BRANCH); resume never checks out another branch"
[[ "$REF_BRANCH" != "$main_branch" ]] \
  || fail "resume never targets main"
if [[ "$BRANCH_GIVEN" == 1 && "$BRANCH" != "$current_branch" ]]; then
  fail "--branch must equal the current branch ($current_branch)"
fi
[[ -z "$(git -C "$REPO_ABS" diff --name-only)" ]] \
  || fail "unstaged tracked changes present; the candidate checkout must be clean"
[[ -z "$(git -C "$REPO_ABS" diff --cached --name-only)" ]] \
  || fail "staged changes present; the candidate checkout must be clean (resume creates no commit)"
[[ -z "$(git -C "$REPO_ABS" ls-files --others --exclude-standard)" ]] \
  || fail "untracked payload present; the candidate checkout must be clean"
candidate_tree="$(git -C "$REPO_ABS" rev-parse "$SHA^{tree}")"
candidate_parent="$(git -C "$REPO_ABS" rev-parse "$SHA^")" \
  || fail "candidate has no parent commit; resume needs the ship-created candidate"
[[ "$(git -C "$REPO_ABS" rev-parse "HEAD^{tree}")" == "$candidate_tree" ]] \
  || fail "candidate tree does not match HEAD tree; deny"
main_sha="$(git -C "$REPO_ABS" rev-parse "refs/heads/main")"
[[ "$SHA" != "$main_sha" ]] \
  || fail "candidate already equals main; resume has nothing to push"
if git -C "$REPO_ABS" merge-base --is-ancestor "$SHA" "refs/heads/main"; then
  fail "candidate already belongs to main history; resume has nothing to push"
fi
git -C "$REPO_ABS" cat-file -e "$SHA:scripts/ship-deploy" >/dev/null 2>&1 \
  || fail "scripts/ship-deploy is not tracked in the candidate tree"
git -C "$REPO_ABS" cat-file -e "$SHA:package.json" >/dev/null 2>&1 \
  || fail "package.json is not tracked in the candidate tree"

# An isolated opt-in needs the fleet runner present before any
# mutation; a missing runner blocks now, never falls back later.
if git -C "$REPO_ABS" cat-file -e "$SHA:.ship/e2e-runner.json" >/dev/null 2>&1; then
  [[ -x "$E2E_RUNNER" ]] || fail "fleet isolated E2E runner missing or not executable: $E2E_RUNNER"
fi

# --- Explicit remote and push-config guards, before any mutation. Push
# configuration must not add refs (mirror/tags) or divert the destination
# (pushurl) away from the explicit remote/ref contract.
git -C "$REPO_ABS" remote get-url "$REMOTE" >/dev/null 2>&1 || fail "remote not configured: $REMOTE"
mirror_value="$(git -C "$REPO_ABS" config --get "remote.$REMOTE.mirror" 2>/dev/null || true)"
case "$(printf '%s' "$mirror_value" | tr '[:upper:]' '[:lower:]')" in
  true|yes|on|1) fail "push config would add refs: remote.$REMOTE.mirror is enabled" ;;
esac
pushurls="$(git -C "$REPO_ABS" config --get-all "remote.$REMOTE.pushurl" 2>/dev/null || true)"
[[ -z "$pushurls" ]] || fail "push config would divert the destination: remote.$REMOTE.pushurl is set"
tag_opt="$(git -C "$REPO_ABS" config --get "remote.$REMOTE.tagOpt" 2>/dev/null || true)"
[[ "$tag_opt" != "--tags" ]] || fail "push config would add refs: remote.$REMOTE.tagOpt is --tags"

# --- Proven prior commit evidence: exactly one immutable ship-build
# commit receipt for this SHA whose content matches the candidate,
# remote, ref, branch, parent, and tree. Without that receipt there
# is no proof the commit was made by the reviewed ship commit step,
# so resume blocks instead of pushing an unverified HEAD. The
# receipt itself is never modified here; the fresh deploy evidence
# from the resumed push is recorded beside it in the same run.
SHIP_RUNS_DIR="$GIT_DIR/ship-runs"
[[ -d "$SHIP_RUNS_DIR" && ! -L "$SHIP_RUNS_DIR" ]] \
  || fail "no proven prior ship attempt (no owned run directory); resume refuses an unverified candidate"
RUN_DIR=""
RUN_ID=""
FOUND=0
for run_candidate in "$SHIP_RUNS_DIR"/*/; do
  [[ -d "$run_candidate" && ! -L "${run_candidate%/}" ]] || continue
  commit_file="$run_candidate/commit.json"
  [[ -f "$commit_file" && ! -L "$commit_file" ]] || continue
  commit_sha="$(python3 - "$commit_file" <<'PYEOF'
import json
import sys
from pathlib import Path
try:
    payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
except (OSError, ValueError):
    print("")
else:
    value = payload.get("sha")
    print(value if isinstance(value, str) else "")
PYEOF
)" || true
  [[ "$commit_sha" == "$SHA" ]] || continue
  FOUND=$((FOUND + 1))
  RUN_DIR="${run_candidate%/}"
  RUN_ID="$(basename -- "$RUN_DIR")"
done
[[ "$FOUND" -eq 1 ]] \
  || fail "prior commit evidence for $SHA must be exactly one receipt (found $FOUND); ambiguous or missing evidence blocks resume"
python3 - "$RUN_DIR/commit.json" "$SHA" "$REMOTE" "$REF" "$REF_BRANCH" "$candidate_tree" "$candidate_parent" "$RUN_ID" <<'PYEOF' || fail "prior commit evidence content does not match the requested candidate/remote/ref/tree"
import json
import sys
from pathlib import Path

payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
candidate, remote, ref, branch, tree, parent, run_id = sys.argv[2:9]
if payload.get("run_id") != run_id:
    print("ship-resume: prior commit evidence run_id mismatch", file=sys.stderr)
    sys.exit(1)
if payload.get("sha") != candidate:
    print("ship-resume: prior commit evidence sha mismatch", file=sys.stderr)
    sys.exit(1)
if payload.get("remote") != remote:
    print("ship-resume: prior commit evidence remote mismatch", file=sys.stderr)
    sys.exit(1)
if payload.get("ref") != ref:
    print("ship-resume: prior commit evidence ref mismatch", file=sys.stderr)
    sys.exit(1)
if payload.get("branch") != branch:
    print("ship-resume: prior commit evidence branch mismatch", file=sys.stderr)
    sys.exit(1)
if payload.get("tree") != tree:
    print("ship-resume: prior commit evidence tree mismatch", file=sys.stderr)
    sys.exit(1)
if payload.get("parent") != parent:
    print("ship-resume: prior commit evidence parent mismatch", file=sys.stderr)
    sys.exit(1)
if payload.get("type") != "commit":
    print("ship-resume: prior commit evidence type mismatch", file=sys.stderr)
    sys.exit(1)
PYEOF
printf 'branch: %s  remote: %s  ref: %s\n' "$current_branch" "$REMOTE" "$REF"
printf 'candidate SHA: %s\n' "$SHA"
printf 'run_id: %s\n' "$RUN_ID"
printf 'run_dir: %s\n' "$RUN_DIR"

# --- Remote ref must be empty or absent. An already-equal ref has
# nothing to resume, and an advanced or conflicting ref must never be
# overwritten (no force is used or allowed here). This read-only
# check runs before the rollout-history checks so an already
# uploaded candidate reports as such, not as a duplicate rollout.
remote_before="$(git -C "$REPO_ABS" ls-remote "$REMOTE" "$REF" | cut -f1 || true)"
if [[ "$remote_before" == "$SHA" ]]; then
  fail "remote ref $REF already equals the candidate; nothing to resume and no success is claimed here"
fi
if [[ -n "$remote_before" ]]; then
  fail "remote ref $REF already points elsewhere ($remote_before); resume will not overwrite an advanced ref"
fi

# A completed deploy receipt means the non-prod rollout for this SHA
# already succeeded in the prior attempt. Rerunning the rollout
# could duplicate its side effects (for example immutable artifacts
# the deploy entry created), which only the owner can accept. Resume
# therefore blocks and reports it instead of guessing.
if [[ -e "$RUN_DIR/deploy.json" || -L "$RUN_DIR/deploy.json" ]]; then
  fail "prior rollout for $SHA already succeeded (deploy evidence present); resume will not duplicate the rollout — report to the owner for a decision"
fi
if [[ -e "$RUN_DIR/resume.json" || -L "$RUN_DIR/resume.json" ]]; then
  fail "a prior resume receipt already exists for this run; its outcome is ambiguous — report for reconciliation instead of resuming again"
fi

# --- Current remote main comparison (off main, never stale).
# Local main may only be behind; the behind-only case fast-forwards
# the main ref without moving HEAD, preserving the retained
# candidate exactly. The ref is fetched first so the counts describe
# the current remote, not a possibly stale remote-tracking ref.
FETCH_OUT="$(mktemp)"
if ! git -C "$REPO_ABS" fetch "$REMOTE" "$main_branch" >"$FETCH_OUT" 2>&1; then
  cat -- "$FETCH_OUT" >&2
  rm -f -- "$FETCH_OUT"
  fail "fetch of $REMOTE/$main_branch failed; cannot compare current main"
fi
cat -- "$FETCH_OUT"
rm -f -- "$FETCH_OUT"
git -C "$REPO_ABS" show-ref --verify -q "refs/remotes/$REMOTE/$main_branch" \
  || fail "remote main tracking ref missing after fetch: $REMOTE/$main_branch"
LOCAL_MAIN_SHA="$(git -C "$REPO_ABS" rev-parse "refs/heads/main")"
REMOTE_MAIN_SHA="$(git -C "$REPO_ABS" rev-parse "refs/remotes/$REMOTE/$main_branch")"
counts="$(git -C "$REPO_ABS" rev-list --left-right --count "refs/heads/main...refs/remotes/$REMOTE/$main_branch")"
AHEAD="$(printf '%s' "$counts" | cut -f1)"
BEHIND="$(printf '%s' "$counts" | cut -f2)"
if [[ "$AHEAD" != "0" && "$BEHIND" != "0" ]]; then
  fail "local main is diverged from $REMOTE/$main_branch (ahead $AHEAD, behind $BEHIND); deny"
fi
if [[ "$AHEAD" != "0" ]]; then
  fail "local main is ahead of $REMOTE/$main_branch (ahead $AHEAD); deny"
fi
if [[ "$BEHIND" != "0" ]]; then
  git -C "$REPO_ABS" merge-base --is-ancestor "$LOCAL_MAIN_SHA" "$REMOTE_MAIN_SHA" \
    || fail "behind-only main is not a descendant fast-forward; deny"
  UPDATE_OUT="$(mktemp)"
  if ! git -C "$REPO_ABS" update-ref "refs/heads/main" "$REMOTE_MAIN_SHA" "$LOCAL_MAIN_SHA" >"$UPDATE_OUT" 2>&1; then
    cat -- "$UPDATE_OUT" >&2
    rm -f -- "$UPDATE_OUT"
    fail "behind-only main could not fast-forward safely; deny"
  fi
  cat -- "$UPDATE_OUT"
  rm -f -- "$UPDATE_OUT"
  printf 'local main was only behind; fast-forwarded (off-main ref update, HEAD unchanged)\n'
  [[ "$(git -C "$REPO_ABS" rev-parse "refs/heads/main")" == "$REMOTE_MAIN_SHA" ]] \
    || fail "fast-forward did not advance local main; deny"
  [[ "$(git -C "$REPO_ABS" rev-parse HEAD)" == "$SHA" ]] \
    || fail "HEAD moved while fast-forwarding main off-main; deny"
  [[ "$(git -C "$REPO_ABS" rev-parse "HEAD^{tree}")" == "$candidate_tree" ]] \
    || fail "candidate tree changed while fast-forwarding main; deny"
  [[ "$(git -C "$REPO_ABS" rev-parse "HEAD^")" == "$candidate_parent" ]] \
    || fail "candidate parent changed while fast-forwarding main; deny"
  [[ "$(git -C "$REPO_ABS" branch --show-current)" == "$current_branch" ]] \
    || fail "branch changed while syncing main; deny"
  [[ -z "$(git -C "$REPO_ABS" diff --name-only)" ]] \
    || fail "unstaged tracked changes after fast-forward; deny"
  [[ -z "$(git -C "$REPO_ABS" ls-files --others --exclude-standard)" ]] \
    || fail "untracked payload after fast-forward; deny"
fi

# --- Mutation boundary: branch, HEAD, tree, and clean checkout are
# re-checked immediately before the push so a concurrent move is
# caught. The remote ref pre-check is repeated for the same reason.
[[ "$(git -C "$REPO_ABS" branch --show-current)" == "$REF_BRANCH" ]] \
  || fail "branch changed before the push boundary; deny"
[[ "$(git -C "$REPO_ABS" rev-parse HEAD)" == "$SHA" ]] \
  || fail "HEAD changed before the push boundary; deny"
[[ "$(git -C "$REPO_ABS" rev-parse "HEAD^{tree}")" == "$candidate_tree" ]] \
  || fail "candidate tree changed before the push boundary; deny"
[[ -z "$(git -C "$REPO_ABS" diff --name-only)" ]] \
  || fail "checkout changed before the push boundary; deny"
[[ -z "$(git -C "$REPO_ABS" diff --cached --name-only)" ]] \
  || fail "index changed before the push boundary; deny"
[[ -z "$(git -C "$REPO_ABS" ls-files --others --exclude-standard)" ]] \
  || fail "checkout changed before the push boundary; deny"
remote_now="$(git -C "$REPO_ABS" ls-remote "$REMOTE" "$REF" | cut -f1 || true)"
if [[ -n "$remote_now" ]]; then
  fail "remote ref $REF appeared before the push boundary ($remote_now); resume will not overwrite it"
fi

# --- Stale intermediate preflight from the failed attempt. It is a
# read-only image check recorded before any rollout, never the
# immutable commit receipt or a rollout receipt. When it provably
# belongs to this run and candidate it is removed so the resumed
# push records honest fresh preflight evidence; dubious evidence is
# never deleted. The validated commit receipt stays untouched.
preflight_evidence="$RUN_DIR/preflight.json"
if [[ -L "$preflight_evidence" ]]; then
  fail "stale preflight evidence is a symlink; refusing to touch ambiguous evidence"
fi
if [[ -e "$preflight_evidence" ]]; then
  EXPECTED_MODE="legacy_host"
  if git -C "$REPO_ABS" cat-file -e "$SHA:.ship/e2e-runner.json" >/dev/null 2>&1; then
    EXPECTED_MODE="isolated_oci"
  fi
  python3 - "$preflight_evidence" "$RUN_ID" "$SHA" "$EXPECTED_MODE" <<'PYEOF' || fail "stale preflight evidence does not match run/candidate; refusing to resume over ambiguous evidence"
import json
import sys
from pathlib import Path

payload = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
run_id, candidate, mode = sys.argv[2:5]
if payload.get("run_id") != run_id or payload.get("sha") != candidate:
    print("ship-resume: stale preflight evidence does not match run/candidate", file=sys.stderr)
    sys.exit(1)
if mode == "isolated_oci":
    if payload.get("type") != "preflight" or payload.get("e2e_mode") != "isolated_oci":
        print("ship-resume: stale preflight evidence type/mode mismatch", file=sys.stderr)
        sys.exit(1)
    for field in ("e2e_image", "e2e_image_id", "e2e_contract_sha256"):
        if not isinstance(payload.get(field), str) or not payload.get(field):
            print(f"ship-resume: stale preflight evidence missing {field}", file=sys.stderr)
            sys.exit(1)
else:
    print("ship-resume: preflight evidence exists for a legacy candidate; ambiguous", file=sys.stderr)
    sys.exit(1)
PYEOF
  rm -- "$preflight_evidence"
  printf 'removed stale preflight evidence from the failed attempt; fresh preflight will be recorded\n'
fi

# --- Push the pinned candidate SHA to the explicit remote/ref. The
# real pre-push hook runs the nested deploy + E2E with fresh
# evidence and blocks upload on failure. The refspec names the exact
# candidate value, so a HEAD that moves between check and push cannot
# change what is uploaded. No automatic retry follows a failed push.
PUSH_OUT="$(mktemp)"
push_status=0
if ! git -C "$REPO_ABS" push "$REMOTE" "$SHA:$REF" >"$PUSH_OUT" 2>&1; then
  push_status=1
fi
cat -- "$PUSH_OUT"
if [[ "$push_status" != "0" ]]; then
  # A failed push does not by itself prove that nothing was uploaded (the
  # transport may fail after the remote accepted the ref). Reconcile by
  # reading the remote, without replaying or deploying again.
  rm -f -- "$PUSH_OUT"
  remote_after_fail="$(git -C "$REPO_ABS" ls-remote "$REMOTE" "$REF" | cut -f1 || true)"
  if [[ "$remote_after_fail" == "$SHA" ]]; then
    printf 'push exited non-zero but the remote ref now equals the candidate; upload occurred, not replaying\n'
  else
    fail "push failed and the remote ref ($remote_after_fail) does not equal the candidate ($SHA) at the reconcile read; no upload observed at that time, not a guarantee that nothing was uploaded; not replaying"
  fi
else
  rm -f -- "$PUSH_OUT"
fi
remote_sha="$(git -C "$REPO_ABS" ls-remote "$REMOTE" "$REF" | cut -f1)"
[[ "$remote_sha" == "$SHA" ]] \
  || fail "post-push verification failed: remote SHA $remote_sha does not equal candidate $SHA (upload already happened; not prevented)"
[[ "$(git -C "$REPO_ABS" rev-parse HEAD)" == "$SHA" ]] \
  || fail "post-push verification failed: HEAD moved after push (upload already happened; not prevented)"
python3 - "$RUN_DIR" "$SHA" "$REMOTE" "$REF" "$RUN_ID" <<'PYEOF' || fail "post-push verification failed: evidence content does not match run/candidate/remote/ref (upload already happened; not prevented)"
import json
import sys
from pathlib import Path

run_dir = Path(sys.argv[1])
candidate = sys.argv[2]
remote = sys.argv[3]
ref = sys.argv[4]
run_id = sys.argv[5]
try:
    commit = json.loads((run_dir / "commit.json").read_text())
    deploy = json.loads((run_dir / "deploy.json").read_text())
except (OSError, ValueError) as error:
    print(f"ship-resume: post-push evidence unreadable: {error}", file=sys.stderr)
    sys.exit(1)
if commit.get("run_id") != run_id or commit.get("sha") != candidate:
    print("ship-resume: post-push commit evidence does not match run/candidate", file=sys.stderr)
    sys.exit(1)
if commit.get("remote") != remote or commit.get("ref") != ref:
    print("ship-resume: post-push commit evidence does not match remote/ref", file=sys.stderr)
    sys.exit(1)
if deploy.get("run_id") != run_id or deploy.get("sha") != candidate:
    print("ship-resume: post-push deploy evidence does not match run/candidate", file=sys.stderr)
    sys.exit(1)
if deploy.get("e2e_mode") not in ("isolated_oci", "legacy_host"):
    print("ship-resume: post-push deploy evidence e2e_mode is missing or unknown", file=sys.stderr)
    sys.exit(1)
if deploy.get("e2e_mode") == "isolated_oci":
    for field in ("e2e_image", "e2e_image_id", "e2e_contract_sha256"):
        if not isinstance(deploy.get(field), str) or not deploy.get(field):
            print(f"ship-resume: post-push isolated deploy evidence missing {field}", file=sys.stderr)
            sys.exit(1)
    try:
        preflight = json.loads((run_dir / "preflight.json").read_text())
    except (OSError, ValueError) as error:
        print(f"ship-resume: post-push preflight evidence unreadable: {error}", file=sys.stderr)
        sys.exit(1)
    if preflight.get("run_id") != run_id or preflight.get("sha") != candidate:
        print("ship-resume: post-push preflight evidence does not match run/candidate", file=sys.stderr)
        sys.exit(1)
    if preflight.get("e2e_image_id") != deploy.get("e2e_image_id"):
        print("ship-resume: post-push preflight image does not match deploy image", file=sys.stderr)
        sys.exit(1)
PYEOF
printf 'pushed: %s -> %s:%s\n' "$SHA" "$REMOTE" "$REF"
printf 'verified: remote SHA matches candidate; prior commit and fresh deploy evidence present\n'

# Record the resume outcome in the same run, bound by content (run,
# candidate, remote, ref, branch). Never overwrite an existing
# resume receipt. This file is written after the post-push
# verification, so a failure here cannot hide the upload above.
resume_evidence="$RUN_DIR/resume.json"
[[ ! -e "$resume_evidence" && ! -L "$resume_evidence" ]] \
  || fail "post-push verification failed: resume evidence already exists; refusing to overwrite (upload already happened; not prevented)"
tmp_resume="$(mktemp "$RUN_DIR/.tmp.XXXXXX")"
python3 - "$tmp_resume" "$RUN_ID" "$SHA" "$REMOTE" "$REF" "$REF_BRANCH" <<'PYEOF' || fail "cannot write resume evidence (upload already happened; not prevented)"

#!/usr/bin/env bash
set -euo pipefail

# Fleet ship-deploy pre-push wrapper.
# Invoked by a repository's .husky/pre-push hook with the Git pre-push ref line
# on stdin. Verifies the candidate commit, deploys it via ./scripts/ship-deploy,
# and runs the repository's full test:e2e suite against that deployment.
# Any non-zero exit blocks the Git push.

err() { printf 'ship-deploy: %s\n' "$*" >&2; }
fail() { err "$*"; exit 1; }

[[ $# -eq 0 ]] || fail "takes no arguments (refs arrive on stdin from git pre-push)"
if [[ "${HUSKY:-}" == "0" ]]; then
  fail "HUSKY=0 is not allowed"
fi
export HUSKY=1

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_node-env.sh
source "$SCRIPT_DIR/_node-env.sh"

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" \
  || fail "must run inside a Git repository"
cd -- "$REPO_ROOT"

# Parse the single outgoing branch push from stdin.
LINES=()
while IFS= read -r line || [[ -n "$line" ]]; do
  [[ -z "$line" ]] && continue
  LINES+=("$line")
done
[[ ${#LINES[@]} -eq 1 ]] || fail "expected exactly 1 ref on stdin (got ${#LINES[@]})"

read -r _LOCAL_REF LOCAL_SHA REMOTE_REF _REMOTE_SHA <<< "${LINES[0]}"
[[ "$REMOTE_REF" == refs/heads/* ]] || fail "remote ref must be a branch (got $REMOTE_REF)"
[[ "$LOCAL_SHA" =~ ^[0-9a-f]{40}$ ]] || fail "invalid outgoing SHA: $LOCAL_SHA"
[[ "$LOCAL_SHA" != "0000000000000000000000000000000000000000" ]] || fail "deletion push is not shippable"

CANDIDATE="$LOCAL_SHA"
REF_BRANCH="${REMOTE_REF#refs/heads/}"

# Ensure HEAD, branch, and working tree match the outgoing commit cleanly.
[[ "$(git rev-parse HEAD)" == "$CANDIDATE" ]] \
  || fail "HEAD does not match outgoing SHA ($CANDIDATE)"
[[ "$(git branch --show-current)" == "$REF_BRANCH" ]] \
  || fail "current branch does not match pushed branch ($REF_BRANCH)"
[[ -z "$(git status --porcelain)" ]] \
  || fail "working tree must be clean before deploy and E2E"

[[ -x "scripts/ship-deploy" ]] || fail "executable scripts/ship-deploy is required"

# Activate pinned Node version (.nvmrc / .node-version) if present.
activate_node_version "$REPO_ROOT"

# 1. Deploy the exact candidate SHA to non-production.
DEPLOY_OUT="$(mktemp)"
trap 'rm -f -- "$DEPLOY_OUT"' EXIT

if ! ./scripts/ship-deploy "$CANDIDATE" >"$DEPLOY_OUT" 2>&1; then
  err "non-production deploy failed for $CANDIDATE:"
  cat -- "$DEPLOY_OUT" >&2
  exit 1
fi
cat -- "$DEPLOY_OUT"

DEPLOYED_LINES="$(grep -c '^SHIP_DEPLOYED_SHA=' "$DEPLOY_OUT" || true)"
[[ "$DEPLOYED_LINES" == "1" ]] \
  || fail "scripts/ship-deploy must print exactly one SHIP_DEPLOYED_SHA=<SHA> line (found $DEPLOYED_LINES)"
DEPLOYED_SHA="$(grep '^SHIP_DEPLOYED_SHA=' "$DEPLOY_OUT" | cut -d= -f2-)"
[[ "$DEPLOYED_SHA" == "$CANDIDATE" ]] \
  || fail "scripts/ship-deploy reported $DEPLOYED_SHA, expected $CANDIDATE"

# 2. Run the full E2E suite against that deployed SHA.
MANAGER="$(python3 -c 'import json; pm=str(json.load(open("package.json")).get("packageManager","")); print(pm.split("@",1)[0])' 2>/dev/null || true)"
case "$MANAGER" in
  npm|pnpm|yarn|bun) ;;
  *) fail "unsupported or missing packageManager in package.json: ${MANAGER:-empty}" ;;
esac

SHIP_TARGET_SHA="$CANDIDATE" SHIP_DEPLOYED_SHA="$CANDIDATE" "$MANAGER" run test:e2e

# 3. Re-verify HEAD and clean tree didn't drift during deploy/E2E.
[[ "$(git rev-parse HEAD)" == "$CANDIDATE" ]] \
  || fail "HEAD moved during deploy/E2E; blocking push"
[[ -z "$(git status --porcelain)" ]] \
  || fail "working tree became dirty during deploy/E2E; blocking push"

printf 'ship-deploy: deploy and test:e2e passed for %s\n' "$CANDIDATE"

mv "$tmp_evidence" "$commit_evidence"

# --- Push to the explicit remote/ref with the pinned candidate SHA. The
# real pre-push hook runs the nested deploy + E2E and blocks upload on
# failure. The refspec names the exact candidate value, so a HEAD that
# moves between commit and push cannot change what is uploaded.
PUSH_OUT="$(mktemp)"
push_status=0
if ! git -C "$REPO_ABS" push "$REMOTE" "$candidate:$REF" >"$PUSH_OUT" 2>&1; then
  push_status=1
fi
cat -- "$PUSH_OUT"
if [[ "$push_status" != "0" ]]; then
  # A failed push does not by itself prove that nothing was uploaded (the
  # transport may fail after the remote accepted the ref). Reconcile by
  # reading the remote, without replaying or deploying again.
  rm -f -- "$PUSH_OUT"
  remote_after_fail="$(git -C "$REPO_ABS" ls-remote "$REMOTE" "$REF" | cut -f1 || true)"
  if [[ "$remote_after_fail" == "$candidate" ]]; then
    printf 'push exited non-zero but the remote ref now equals the candidate; upload occurred, not replaying\n'
  else
    fail "push failed and the remote ref ($remote_after_fail) does not equal the candidate ($candidate) at the reconcile read; no upload observed at that time, not a guarantee that nothing was uploaded; not replaying"
  fi
else
  rm -f -- "$PUSH_OUT"
fi
remote_sha="$(git -C "$REPO_ABS" ls-remote "$REMOTE" "$REF" | cut -f1)"
[[ "$remote_sha" == "$candidate" ]] \
  || fail "post-push verification failed: remote SHA $remote_sha does not equal candidate $candidate (upload already happened; not prevented)"
[[ "$(git -C "$REPO_ABS" rev-parse HEAD)" == "$candidate" ]] \
  || fail "post-push verification failed: HEAD moved after push (upload already happened; not prevented)"
python3 - "$RUN_DIR" "$candidate" "$REMOTE" "$REF" "$RUN_ID" <<'PYEOF' || fail "post-push verification failed: evidence content does not match run/candidate/remote/ref (upload already happened; not prevented)"
import json
import sys
from pathlib import Path

run_dir = Path(sys.argv[1])
candidate = sys.argv[2]
remote = sys.argv[3]
ref = sys.argv[4]
run_id = sys.argv[5]
try:
    commit = json.loads((run_dir / "commit.json").read_text())
    deploy = json.loads((run_dir / "deploy.json").read_text())
except (OSError, ValueError) as error:
    print(f"ship-build: post-push evidence unreadable: {error}", file=sys.stderr)
    sys.exit(1)
if commit.get("run_id") != run_id or commit.get("sha") != candidate:
    print("ship-build: post-push commit evidence does not match run/candidate", file=sys.stderr)
    sys.exit(1)
if commit.get("remote") != remote or commit.get("ref") != ref:
    print("ship-build: post-push commit evidence does not match remote/ref", file=sys.stderr)
    sys.exit(1)
if deploy.get("run_id") != run_id or deploy.get("sha") != candidate:
    print("ship-build: post-push deploy evidence does not match run/candidate", file=sys.stderr)
    sys.exit(1)
PYEOF
printf 'pushed: %s -> %s:%s\n' "$candidate" "$REMOTE" "$REF"
printf 'verified: remote SHA matches candidate; commit and deploy evidence present\n'

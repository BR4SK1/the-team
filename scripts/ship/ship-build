#!/usr/bin/env bash
set -euo pipefail

# Fleet ship-build: validates opt-in and effective Husky wiring, then
# performs a plain git commit of the staged set and a push to an
# explicit remote/ref. The real pre-push hook (fleet ship-deploy)
# performs the nested non-prod rollout and full test:e2e before upload.
# Usage:
#   ship-build <repo> --remote <name> --ref refs/heads/<topic>
#              [--branch <topic>] --message <message>
# No implicit staging, no bypass flags, no automatic retries.

err() { printf 'ship-build: %s\n' "$*" >&2; }
fail() { err "$*"; exit 1; }

ME="${BASH_SOURCE[0]}"
# Fleet checkout root: two levels above scripts/ship/.
FLEET_ROOT="$(cd -- "$(dirname -- "$ME")/../.." && pwd)"
DOCTOR="$FLEET_ROOT/scripts/ship/ship-doctor"
SHIP_DEPLOY_WRAPPER="$FLEET_ROOT/scripts/ship/ship-deploy"

[[ $# -ge 1 ]] || fail "usage: ship-build <repo> --remote <name> --ref <ref> [--branch <topic>] --message <msg>"
REPO="$1"; shift
REMOTE=""; REF=""; BRANCH=""; MESSAGE=""; BRANCH_GIVEN=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --remote) [[ $# -ge 2 ]] || fail "--remote requires a value"; REMOTE="$2"; shift 2 ;;
    --ref) [[ $# -ge 2 ]] || fail "--ref requires a value"; REF="$2"; shift 2 ;;
    --branch) [[ $# -ge 2 ]] || fail "--branch requires a value"; BRANCH="$2"; BRANCH_GIVEN=1; shift 2 ;;
    --message) [[ $# -ge 2 ]] || fail "--message requires a value"; MESSAGE="$2"; shift 2 ;;
    *) fail "unknown argument: $1" ;;
  esac
done
[[ -n "$REMOTE" ]] || fail "--remote is required (explicit remote name)"
[[ -n "$REF" ]] || fail "--ref is required (explicit refs/heads/<topic>)"
[[ -n "$MESSAGE" ]] || fail "--message is required (non-empty commit message)"
[[ "$REF" == refs/heads/* ]] || fail "--ref must be a branch ref (refs/heads/<topic>)"
REF_BRANCH="${REF#refs/heads/}"
[[ -n "$REF_BRANCH" && "$REF_BRANCH" != "$REF" ]] || fail "--ref must name a branch"
[[ -d "$REPO" ]] || fail "repository path does not exist or is not a directory"
REPO_ABS="$(cd -- "$REPO" && pwd)"
[[ -x "$DOCTOR" ]] || fail "fleet doctor missing or not executable: $DOCTOR"
[[ -x "$SHIP_DEPLOY_WRAPPER" ]] || fail "fleet ship-deploy wrapper missing or not executable: $SHIP_DEPLOY_WRAPPER"

# Husky disable risk: an inherited HUSKY=0 would silently skip every gate
# via the helper ([ "${HUSKY-}" = "0" ] && exit 0). Refuse it, then set
# HUSKY=1 explicitly so the commit and push hooks below run even when the
# parent environment left HUSKY unset. The helper also sources
# $XDG_CONFIG_HOME/husky/init.sh (or ~/.config/husky/init.sh) before
# checking HUSKY; a disable there is refused below too.
if [[ -n "${HUSKY:-}" && "$HUSKY" == "0" ]]; then
  fail "bypass disabled: HUSKY=0 would disable the Husky gates"
fi
export HUSKY=1

# --- Step 1 gate: doctor must report local_pass before any mutation.
DOCTOR_OUT="$("$DOCTOR" "$REPO_ABS")" || fail "doctor did not report local_pass (blocked or indeterminate)"
printf '%s\n' "$DOCTOR_OUT" | python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if d.get("result")=="local_pass" else 1)' \
  || fail "doctor did not report local_pass"

# --- Git layout: explicit root and an ordinary (non-symlink) .git.
git -C "$REPO_ABS" rev-parse --git-dir >/dev/null 2>&1 || fail "not a Git repository"
GIT_DIR="$(git -C "$REPO_ABS" rev-parse --absolute-git-dir)" || fail "not a Git repository"
[[ -d "$GIT_DIR" && ! -L "$GIT_DIR" ]] || fail "unsafe Git layout: .git must be a directory, not a symlink"
TOPLEVEL="$(git -C "$REPO_ABS" rev-parse --show-toplevel)"
[[ "$TOPLEVEL" == "$REPO_ABS" ]] || fail "repo path must be the repository root"
current_branch="$(git -C "$REPO_ABS" branch --show-current)" || true
if [[ -z "$current_branch" ]]; then
  fail "detached HEAD is not shippable; check out an explicit branch"
fi
# The return target is fixed: main. A master fallback would conflict with
# the Step 5 return-to-main, so it is not supported.
main_branch="main"
git -C "$REPO_ABS" show-ref --verify -q "refs/heads/main" \
  || fail "local main is missing; the ship standard returns to main (no master fallback)"

# Inherited Husky init must not disable the gates. The helper sources the
# init shard before its own HUSKY check, so this is validated here.
INIT_CANDIDATE="${XDG_CONFIG_HOME:-$HOME/.config}/husky/init.sh"
if [[ -e "$INIT_CANDIDATE" ]]; then
  [[ -f "$INIT_CANDIDATE" && ! -L "$INIT_CANDIDATE" ]] \
    || fail "unsafe Husky init: $INIT_CANDIDATE must be a regular file"
  if grep -Eq 'HUSKY[[:space:]]*=[[:space:]]*0' "$INIT_CANDIDATE"; then
    fail "Husky init disables the gates (HUSKY=0 in $INIT_CANDIDATE)"
  fi
fi

# --- Effective Husky wiring, before mutation. Shape alone (executable
# shims) accepts no-op shims and comment-only hooks that would let a
# normal push upload before any deploy receipt exists. The checks below
# prove the genuine installed v9 runtime instead: the helper is exactly
# the installed package's helper, each shim is exactly the runtime's
# generated shim, and pre-push is exactly the standard exec delegation.
hooks_path="$(git -C "$REPO_ABS" config --get core.hooksPath 2>/dev/null || true)"
[[ "$hooks_path" == ".husky/_" ]] || fail "wrong wiring: core.hooksPath must be .husky/_ (effective Husky runtime missing)"
for f in .husky/pre-commit .husky/commit-msg .husky/pre-push; do
  [[ -f "$REPO_ABS/$f" && ! -L "$REPO_ABS/$f" ]] || fail "wrong wiring: $f must be a regular file"
done
for f in .husky/_/pre-commit .husky/_/commit-msg .husky/_/pre-push; do
  [[ -f "$REPO_ABS/$f" && ! -L "$REPO_ABS/$f" && -x "$REPO_ABS/$f" ]] \
    || fail "wrong wiring: $f must be a regular executable shim"
done
[[ -f "$REPO_ABS/.husky/_/h" && ! -L "$REPO_ABS/.husky/_/h" ]] \
  || fail "wrong wiring: .husky/_/h must be a regular file"

# Installed runtime, deliberately: declared dependency plus the installed
# package must both pin Husky v9. Without the installed copy there is no
# trusted helper to compare against, so missing is a block (run a pinned
# install), not an assumption.
[[ -f "$REPO_ABS/node_modules/husky/package.json" && ! -L "$REPO_ABS/node_modules/husky/package.json" ]] \
  || fail "installed Husky runtime missing: node_modules/husky/package.json (run a pinned install)"
[[ -f "$REPO_ABS/node_modules/husky/husky" && ! -L "$REPO_ABS/node_modules/husky/husky" ]] \
  || fail "installed Husky runtime missing: node_modules/husky/husky"
python3 - "$REPO_ABS" <<'PYEOF' || fail "installed Husky runtime must be v9 and match the declared dependency"
import json
import re
import sys
from pathlib import Path

repo = Path(sys.argv[1])
try:
    installed = json.loads((repo / "node_modules/husky/package.json").read_text())
    version = installed.get("version")
except (OSError, ValueError) as error:
    print(f"ship-build: installed Husky package.json unreadable: {error}", file=sys.stderr)
    sys.exit(1)
if not isinstance(version, str) or not re.match(r"^9\.", version):
    print("ship-build: installed Husky must be v9", file=sys.stderr)
    sys.exit(1)
try:
    declared_pkg = json.loads((repo / "package.json").read_text())
except (OSError, ValueError) as error:
    print(f"ship-build: package.json unreadable: {error}", file=sys.stderr)
    sys.exit(1)
declared = None
for section in ("devDependencies", "dependencies"):
    values = declared_pkg.get(section)
    if isinstance(values, dict) and "husky" in values:
        declared = values["husky"]
        break
if not isinstance(declared, str) or not declared.strip():
    print("ship-build: declared husky dependency missing", file=sys.stderr)
    sys.exit(1)
cleaned = declared.strip().lstrip("^~>=< ")
if not (cleaned == "9" or cleaned.startswith("9.") or re.search(r"(^|[^0-9])9(\.|$)", declared)):
    print("ship-build: declared husky dependency must pin v9", file=sys.stderr)
    sys.exit(1)
PYEOF

# The helper must be exactly the installed helper (Husky install copies
# node_modules/husky/husky to .husky/_/h). A stub helper that merely
# returns success is therefore rejected.
if ! cmp -s -- "$REPO_ABS/.husky/_/h" "$REPO_ABS/node_modules/husky/husky"; then
  fail "wrong wiring: .husky/_/h must exactly match the installed Husky helper"
fi
# Each shim must be exactly the runtime's generated shim (Husky install
# writes '#!/usr/bin/env sh' plus . "$(dirname "$0")/h"). A no-op shim
# such as 'exit 0' is rejected.
# shellcheck disable=SC2016
EXPECTED_SHIM='#!/usr/bin/env sh
. "$(dirname "$0")/h"'
for shim_hook in pre-commit commit-msg pre-push; do
  shim_path="$REPO_ABS/.husky/_/$shim_hook"
  shim_content="$(cat -- "$shim_path")"
  [[ "$shim_content" == "$EXPECTED_SHIM" ]] \
    || fail "wrong wiring: $shim_path must be the exact Husky v9 shim"
done

# User hooks: non-trivial gate bodies (never executed here) and no bypass
# strings. An empty, comment-only, or trivial 'exit 0'/'true' body is not
# a gate; a comment-only pre-push mentioning the wrapper path is not a
# delegation. The effective (non-comment, non-blank) lines are decisive,
# never a substring of a comment.
python3 - "$REPO_ABS" "$FLEET_ROOT" <<'PYEOF' || fail "wrong wiring: hook bodies or pre-push delegation are not the effective standard wiring"
import sys
from pathlib import Path

repo = Path(sys.argv[1])
fleet_root = sys.argv[2]
expected_pre_push = f'exec "{fleet_root}/scripts/ship/ship-deploy"'

def effective_lines(path):
    text = path.read_text(encoding="utf-8")
    lines = []
    for raw in text.splitlines():
        stripped = raw.strip()
        if not stripped:
            continue
        if stripped.startswith("#!"):
            continue
        if stripped.startswith("#"):
            continue
        lines.append(stripped)
    return lines, text

for name in ("pre-commit", "commit-msg"):
    path = repo / ".husky" / name
    lines, _text = effective_lines(path)
    if not lines:
        print(f"ship-build: wrong wiring: .husky/{name} must contain a gate command", file=sys.stderr)
        sys.exit(1)
    if all(line in ("exit 0", "exit 0;", "true", "true;", ":") for line in lines):
        print(f"ship-build: wrong wiring: .husky/{name} is a no-op, not a gate", file=sys.stderr)
        sys.exit(1)
pre_push_path = repo / ".husky" / "pre-push"
pre_push_lines, _ = effective_lines(pre_push_path)
if pre_push_lines != [expected_pre_push]:
    print(
        "ship-build: wrong wiring: .husky/pre-push must delegate with exactly "
        f"one effective line: {expected_pre_push}",
        file=sys.stderr,
    )
    sys.exit(1)
for name in ("pre-commit", "commit-msg", "pre-push"):
    text = (repo / ".husky" / name).read_text(encoding="utf-8")
    if "--no-verify" in text or "HUSKY=0" in text:
        print(f"ship-build: wrong wiring: .husky/{name} disables the gates", file=sys.stderr)
        sys.exit(1)
PYEOF

[[ -f "$REPO_ABS/scripts/ship-deploy" && -x "$REPO_ABS/scripts/ship-deploy" ]] || fail "opt-in missing: executable scripts/ship-deploy is required"
[[ ! -L "$REPO_ABS/scripts/ship-deploy" ]] || fail "opt-in invalid: scripts/ship-deploy must not be a symlink"

# --- Explicit remote and push-config guards, before any mutation. Push
# configuration must not add refs (mirror/tags) or divert the destination
# (pushurl) away from the explicit remote/ref contract.
git -C "$REPO_ABS" remote get-url "$REMOTE" >/dev/null 2>&1 || fail "remote not configured: $REMOTE"
mirror_value="$(git -C "$REPO_ABS" config --get "remote.$REMOTE.mirror" 2>/dev/null || true)"
case "$(printf '%s' "$mirror_value" | tr '[:upper:]' '[:lower:]')" in
  true|yes|on|1) fail "push config would add refs: remote.$REMOTE.mirror is enabled" ;;
esac
pushurls="$(git -C "$REPO_ABS" config --get-all "remote.$REMOTE.pushurl" 2>/dev/null || true)"
[[ -z "$pushurls" ]] || fail "push config would divert the destination: remote.$REMOTE.pushurl is set"
tag_opt="$(git -C "$REPO_ABS" config --get "remote.$REMOTE.tagOpt" 2>/dev/null || true)"
[[ "$tag_opt" != "--tags" ]] || fail "push config would add refs: remote.$REMOTE.tagOpt is --tags"

# --- Owned per-run evidence path under .git, reserved before mutation.
# Internal run evidence lives in an owned per-run directory, never in a
# user-visible worktree path that a symlink or existing file could
# capture. The run directory must not pre-exist (no overwrite, no reuse).
SHIP_RUNS_DIR="$GIT_DIR/ship-runs"
if [[ -e "$SHIP_RUNS_DIR" || -L "$SHIP_RUNS_DIR" ]]; then
  [[ -d "$SHIP_RUNS_DIR" && ! -L "$SHIP_RUNS_DIR" ]] \
    || fail "evidence parent must be an owned directory, not a symlink: $SHIP_RUNS_DIR"
fi
if [[ ! -d "$SHIP_RUNS_DIR" ]]; then
  mkdir "$SHIP_RUNS_DIR" || fail "cannot create owned evidence parent: $SHIP_RUNS_DIR"
fi
RUN_ID="$(date -u +%Y%m%dT%H%M%S)-$$-$RANDOM"
RUN_DIR="$SHIP_RUNS_DIR/$RUN_ID"
[[ ! -e "$RUN_DIR" && ! -L "$RUN_DIR" ]] \
  || fail "run evidence directory already exists; refusing to overwrite: $RUN_DIR"
mkdir "$RUN_DIR" || fail "cannot create run evidence directory: $RUN_DIR"

# --- Staged, unstaged, and untracked facts (no implicit staging).
staged_files="$(git -C "$REPO_ABS" diff --cached --name-only)"
unstaged_files="$(git -C "$REPO_ABS" diff --name-only)"
untracked="$(git -C "$REPO_ABS" ls-files --others --exclude-standard || true)"
if [[ -z "$staged_files" ]]; then
  fail "no staged scope; stage the intended set explicitly (no implicit staging)"
fi
if [[ -n "$unstaged_files" ]]; then
  fail "unstaged tracked changes present; the candidate must be clean (no sweep-in)"
fi
if [[ -n "$untracked" ]]; then
  fail "untracked payload present; reject before publish (untracked files must not ship as an implicit payload)"
fi
printf 'staged files:\n%s\n' "$staged_files"
staged_tree="$(git -C "$REPO_ABS" write-tree)"
staged_files_before="$(git -C "$REPO_ABS" diff --cached --name-only)"
staged_patch_before="$(git -C "$REPO_ABS" diff --cached)"
head_before="$(git -C "$REPO_ABS" rev-parse HEAD)"

# --- Current remote main comparison (on and off main, never stale).
# The ref is fetched first so the counts describe the current remote, not
# a possibly stale remote-tracking ref. Counts use
# refs/heads/main...remote/main: left is local-only (ahead), right is
# remote-only (behind). Fetch output is preserved for the operator.
FETCH_OUT="$(mktemp)"
if ! git -C "$REPO_ABS" fetch "$REMOTE" "$main_branch" >"$FETCH_OUT" 2>&1; then
  cat -- "$FETCH_OUT" >&2
  rm -f -- "$FETCH_OUT"
  fail "fetch of $REMOTE/$main_branch failed; cannot compare current main"
fi
cat -- "$FETCH_OUT"
rm -f -- "$FETCH_OUT"
git -C "$REPO_ABS" show-ref --verify -q "refs/remotes/$REMOTE/$main_branch" \
  || fail "remote main tracking ref missing after fetch: $REMOTE/$main_branch"
LOCAL_MAIN_SHA="$(git -C "$REPO_ABS" rev-parse "refs/heads/main")"
REMOTE_MAIN_SHA="$(git -C "$REPO_ABS" rev-parse "refs/remotes/$REMOTE/$main_branch")"
counts="$(git -C "$REPO_ABS" rev-list --left-right --count "refs/heads/main...refs/remotes/$REMOTE/$main_branch")"
AHEAD="$(printf '%s' "$counts" | cut -f1)"
BEHIND="$(printf '%s' "$counts" | cut -f2)"
if [[ "$AHEAD" != "0" && "$BEHIND" != "0" ]]; then
  fail "local main is diverged from $REMOTE/$main_branch (ahead $AHEAD, behind $BEHIND); deny"
fi
if [[ "$AHEAD" != "0" ]]; then
  fail "local main is ahead of $REMOTE/$main_branch (ahead $AHEAD); deny"
fi
if [[ "$BEHIND" != "0" ]]; then
  # Behind-only: fast-forward only when the fast-forward is possible and
  # cannot overwrite the reviewed staged patch. A staged file that also
  # changed upstream makes the fast-forward unsafe; block before mutation.
  git -C "$REPO_ABS" merge-base --is-ancestor "$LOCAL_MAIN_SHA" "$REMOTE_MAIN_SHA" \
    || fail "behind-only main is not a descendant fast-forward; deny"
  changed_upstream="$(git -C "$REPO_ABS" diff --name-only "$LOCAL_MAIN_SHA" "$REMOTE_MAIN_SHA")"
  if [[ -n "$changed_upstream" && -n "$staged_files_before" ]]; then
    while IFS= read -r candidate_file; do
      [[ -z "$candidate_file" ]] && continue
      if printf '%s\n' "$changed_upstream" | grep -Fxq -- "$candidate_file"; then
        fail "behind-only main fast-forward would overwrite staged work ($candidate_file changed upstream); deny before mutation"
      fi
    done <<< "$staged_files_before"
  fi
  if [[ "$current_branch" == "$main_branch" ]]; then
    # On main: fast-forward by merging the remote tip into HEAD.
    MERGE_OUT="$(mktemp)"
    if ! git -C "$REPO_ABS" merge --ff-only "$REMOTE_MAIN_SHA" >"$MERGE_OUT" 2>&1; then
      cat -- "$MERGE_OUT" >&2
      rm -f -- "$MERGE_OUT"
      fail "behind-only main could not fast-forward safely; deny"
    fi
    cat -- "$MERGE_OUT"
    rm -f -- "$MERGE_OUT"
    printf 'local main was only behind; fast-forwarded\n'
  else
    # Off main: HEAD must not move, so fast-forward the main ref directly
    # (guarded by the old value) and keep the staged patch untouched.
    UPDATE_OUT="$(mktemp)"
    if ! git -C "$REPO_ABS" update-ref "refs/heads/main" "$REMOTE_MAIN_SHA" "$LOCAL_MAIN_SHA" >"$UPDATE_OUT" 2>&1; then
      cat -- "$UPDATE_OUT" >&2
      rm -f -- "$UPDATE_OUT"
      fail "behind-only main could not fast-forward safely; deny"
    fi
    cat -- "$UPDATE_OUT"
    rm -f -- "$UPDATE_OUT"
    printf 'local main was only behind; fast-forwarded (off-main ref update, HEAD unchanged)\n'
  fi
  [[ "$(git -C "$REPO_ABS" rev-parse "refs/heads/main")" == "$REMOTE_MAIN_SHA" ]] \
    || fail "fast-forward did not advance local main; deny"
  # Preservation is the staged patch itself (HEAD moved on main, so the
  # absolute tree necessarily changes when upstream files arrive).
  [[ "$(git -C "$REPO_ABS" diff --cached)" == "$staged_patch_before" ]] \
    || fail "fast-forward did not preserve the staged patch; deny"
  staged_tree="$(git -C "$REPO_ABS" write-tree)"
  [[ -z "$(git -C "$REPO_ABS" diff --name-only)" ]] \
    || fail "unstaged tracked changes after fast-forward; deny"
  [[ -z "$(git -C "$REPO_ABS" ls-files --others --exclude-standard)" ]] \
    || fail "untracked payload after fast-forward; deny"
  if [[ "$current_branch" == "$main_branch" ]]; then
    [[ "$(git -C "$REPO_ABS" rev-parse HEAD)" == "$REMOTE_MAIN_SHA" ]] \
      || fail "HEAD did not fast-forward with local main on main; deny"
  else
    [[ "$(git -C "$REPO_ABS" rev-parse HEAD)" == "$head_before" ]] \
      || fail "HEAD moved while fast-forwarding main off-main; deny"
  fi
  [[ "$(git -C "$REPO_ABS" branch --show-current)" == "$current_branch" ]] \
    || fail "branch changed while syncing main; deny"
  staged_files="$(git -C "$REPO_ABS" diff --cached --name-only)"
  [[ -n "$staged_files" ]] || fail "staged scope lost after fast-forward; deny"
fi

# --- Branch handling. On main, a new explicit topic branch is created;
# off main, the current branch is used. The staged tree and HEAD are
# re-checked at the mutation boundary so a concurrent move is caught.
[[ "$(git -C "$REPO_ABS" branch --show-current)" == "$current_branch" ]] \
  || fail "branch changed before the branch boundary; deny"
[[ "$(git -C "$REPO_ABS" write-tree)" == "$staged_tree" ]] \
  || fail "staged tree changed before the branch boundary; deny"
if [[ "$current_branch" == "$main_branch" ]]; then
  [[ "$BRANCH_GIVEN" == 1 && -n "$BRANCH" ]] || fail "starting on main requires --branch <topic> (safe topic branch)"
  [[ "$BRANCH" == "$REF_BRANCH" ]] || fail "--branch must equal --ref branch ($BRANCH vs $REF_BRANCH)"
  [[ "$BRANCH" != "$main_branch" ]] || fail "topic branch must not be main"
  [[ "$BRANCH" =~ ^[A-Za-z0-9][A-Za-z0-9/_-]*$ ]] || fail "unsafe branch name: $BRANCH"
  [[ "$BRANCH" != *".."* ]] || fail "unsafe branch name: $BRANCH"
  if git -C "$REPO_ABS" show-ref --verify -q "refs/heads/$BRANCH"; then
    fail "topic branch already exists: $BRANCH"
  fi
  SWITCH_OUT="$(mktemp)"
  if ! git -C "$REPO_ABS" switch -c "$BRANCH" >"$SWITCH_OUT" 2>&1; then
    cat -- "$SWITCH_OUT" >&2
    rm -f -- "$SWITCH_OUT"
    fail "could not create topic branch $BRANCH"
  fi
  cat -- "$SWITCH_OUT"
  rm -f -- "$SWITCH_OUT"
  printf 'created topic branch: %s\n' "$BRANCH"
else
  if [[ "$BRANCH_GIVEN" == 1 && "$BRANCH" != "$current_branch" ]]; then
    fail "off-main: --branch must equal the current branch ($current_branch)"
  fi
  [[ "$REF_BRANCH" == "$current_branch" ]] || fail "off-main: --ref branch must equal the current branch ($current_branch)"
fi
printf 'branch: %s  remote: %s  ref: %s\n' "$(git -C "$REPO_ABS" branch --show-current)" "$REMOTE" "$REF"

# Review outgoing commits (base..HEAD excluding the new commit).
base_ref="main"
printf 'outgoing commits (before new commit):\n'
git -C "$REPO_ABS" log --oneline "${base_ref}..HEAD" | sed 's/^/  /' || true

# --- Commit the reviewed staged set with a plain git commit (never with
# bypass flags). Hook output is preserved, never discarded.
parent_before="$(git -C "$REPO_ABS" rev-parse HEAD)"
staged_tree_before="$(git -C "$REPO_ABS" write-tree)"
COMMIT_OUT="$(mktemp)"
if ! git -C "$REPO_ABS" commit -m "$MESSAGE" >"$COMMIT_OUT" 2>&1; then
  cat -- "$COMMIT_OUT" >&2
  rm -f -- "$COMMIT_OUT"
  err "commit failed (Husky commit gates did not pass); push blocked, no upload"
  exit 1
fi
cat -- "$COMMIT_OUT"
rm -f -- "$COMMIT_OUT"
candidate="$(git -C "$REPO_ABS" rev-parse HEAD)"
candidate_tree="$(git -C "$REPO_ABS" rev-parse "HEAD^{tree}")"
candidate_parent="$(git -C "$REPO_ABS" rev-parse "HEAD^")"
[[ "$candidate_parent" == "$parent_before" ]] \
  || fail "candidate parent does not equal the reviewed parent; deny"
[[ "$candidate_tree" == "$staged_tree_before" ]] \
  || fail "candidate tree does not equal the reviewed staged tree; deny"
[[ "$(git -C "$REPO_ABS" branch --show-current)" == "$REF_BRANCH" ]] \
  || fail "branch changed at the commit boundary; deny"
if [[ -n "$(git -C "$REPO_ABS" diff --name-only)" ]]; then
  fail "unstaged tracked changes after commit; candidate must be clean"
fi
if [[ -n "$(git -C "$REPO_ABS" diff --cached --name-only)" ]]; then
  fail "staged changes remain after commit; candidate must be clean"
fi
if [[ -n "$(git -C "$REPO_ABS" ls-files --others --exclude-standard)" ]]; then
  fail "untracked payload after commit; candidate must be clean"
fi
printf 'candidate SHA: %s\n' "$candidate"
printf 'outgoing commits (including candidate):\n'
git -C "$REPO_ABS" log --oneline "${base_ref}..HEAD" | sed 's/^/  /' || true
printf 'run_id: %s\n' "$RUN_ID"
printf 'run_dir: %s\n' "$RUN_DIR"

# Record commit evidence for the exact candidate, bound by content (run,
# candidate, remote, ref, parent, tree), never by filename alone. The
# deploy wrapper re-validates the content, not the name.
commit_evidence="$RUN_DIR/commit.json"
[[ ! -e "$commit_evidence" && ! -L "$commit_evidence" ]] \
  || fail "commit evidence already exists; refusing to overwrite"
tmp_evidence="$(mktemp "$RUN_DIR/.tmp.XXXXXX")"
python3 - "$RUN_DIR/.tmp.$$" "$tmp_evidence" "$RUN_ID" "$candidate" "$REMOTE" "$REF" "$REF_BRANCH" "$parent_before" "$staged_tree_before" <<'PYEOF' || fail "cannot write commit evidence"
import json
import sys

tmp_path = sys.argv[1]
out_path = sys.argv[2]
payload = {
    "run_id": sys.argv[3],
    "sha": sys.argv[4],
    "remote": sys.argv[5],
    "ref": sys.argv[6],
    "branch": sys.argv[7],
    "parent": sys.argv[8],
    "tree": sys.argv[9],
    "type": "commit",
}
with open(out_path, "w", encoding="utf-8") as handle:
    handle.write(json.dumps(payload, indent=2) + "\n")

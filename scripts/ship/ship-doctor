#!/usr/bin/env python3
"""Read-only @ship compatibility checker.

Checks whether a repository explicitly conforms to the @ship opt-in standard
and reports actionable remediation steps for anything missing.

Usage:
  ship-doctor <repo-path>

Exit codes:
  0  ready (all checks passed)
  1  not_ready (one or more requirements missing or misconfigured)
  2  usage / invalid path
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

FLEET_ROOT = Path(__file__).resolve().parents[2]
EXPECTED_DEPLOY_WRAPPER = FLEET_ROOT / "scripts" / "ship" / "ship-deploy"

MANAGER_LOCKFILES = {
    "npm": ("package-lock.json",),
    "pnpm": ("pnpm-lock.yaml",),
    "yarn": ("yarn.lock",),
    "bun": ("bun.lock", "bun.lockb"),
}

PACKAGE_MANAGER_RE = re.compile(
    r"^(npm|pnpm|yarn|bun)@[0-9]+\.[0-9]+\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
)

GITHUB_PATTERNS = (
    re.compile(r"^(?:https?|ssh)://(?:[^@/]+@)?github\.com/([^/\s]+)/([^/\s]+?)(?:\.git)?$"),
    re.compile(r"^git@github\.com:([^/\s]+)/([^/\s]+?)(?:\.git)?$"),
)

DISABLE_PATTERNS = (
    re.compile(r"--no-verify"),
    re.compile(r"HUSKY\s*=\s*0"),
)


def git(repo: Path, *args: str) -> tuple[int, str]:
    proc = subprocess.run(
        ["git", "--no-optional-locks", "-C", str(repo), *args],
        capture_output=True,
        text=True,
        timeout=15,
    )
    return proc.returncode, proc.stdout.strip()


def effective_lines(path: Path) -> list[str]:
    lines: list[str] = []
    for raw in path.read_text(encoding="utf-8").splitlines():
        stripped = raw.strip()
        if not stripped or stripped.startswith("#"):
            continue
        lines.append(stripped)
    return lines


def find_node_version(wanted: str) -> str | None:
    try:
        proc = subprocess.run(
            ["node", "--version"], capture_output=True, text=True, timeout=5
        )
        if proc.returncode == 0 and proc.stdout.strip().lstrip("v") == wanted:
            return "PATH"
    except OSError:
        pass
    home = Path.home()
    nvm_dir = Path(os.environ.get("NVM_DIR", str(home / ".nvm")))
    candidates = (
        nvm_dir / "versions" / "node" / f"v{wanted}" / "bin" / "node",
        home / ".local/share/fnm/node-versions" / f"v{wanted}" / "installation/bin/node",
        home / ".local/share/mise/installs/node" / wanted / "bin/node",
        home / ".volta/tools/image/node" / wanted / "bin/node",
    )
    for path in candidates:
        if path.is_file() and os.access(path, os.X_OK):
            return str(path)
    return None


def main(argv: list[str]) -> int:
    if len(argv) != 1 or argv[0].startswith("-"):
        print("usage: ship-doctor <repo-path>", file=sys.stderr)
        return 2

    repo = Path(argv[0]).resolve()
    if not repo.is_dir():
        print(f"ship-doctor: not a directory: {argv[0]}", file=sys.stderr)
        return 2

    checks: list[dict[str, object]] = []
    issues: list[dict[str, str]] = []

    def record(check_id: str, ok: bool, detail: str, fix: str = "") -> None:
        checks.append({"id": check_id, "ok": ok, "detail": detail})
        if not ok:
            issues.append({"id": check_id, "detail": detail, "fix": fix})

    # 1. Git repository root + local main branch
    rc_top, toplevel = git(repo, "rev-parse", "--show-toplevel")
    if rc_top != 0 or Path(toplevel).resolve() != repo:
        record(
            "git.repo",
            False,
            "not a Git repository root",
            "Run ship-doctor against the root directory of a Git repository.",
        )
        return emit(repo, None, checks, issues)

    rc_main, _ = git(repo, "show-ref", "--verify", "-q", "refs/heads/main")
    if rc_main != 0:
        record(
            "git.repo",
            False,
            "local 'main' branch is missing",
            "Ensure the repository has a local 'main' branch.",
        )
    else:
        record("git.repo", True, "ok")

    # 2. GitHub remote
    _, remotes_out = git(repo, "remote")
    remotes = [r for r in remotes_out.splitlines() if r]
    github_remotes = []
    for remote in remotes:
        urls = []
        rc_cfg, cfg_url = git(repo, "config", "--get", f"remote.{remote}.url")
        if rc_cfg == 0 and cfg_url:
            urls.append(cfg_url)
        rc_url, eff_url = git(repo, "remote", "get-url", remote)
        if rc_url == 0 and eff_url and eff_url not in urls:
            urls.append(eff_url)
        if any(p.match(u) for u in urls for p in GITHUB_PATTERNS):
            github_remotes.append(remote)
    if not github_remotes:
        record(
            "git.remote",
            False,
            "no GitHub remote configured",
            "Add a GitHub remote (e.g. git remote add origin git@github.com:<owner>/<repo>.git).",
        )
    else:
        record("git.remote", True, f"ok ({', '.join(github_remotes)})")

    # 3. package.json
    pkg_path = repo / "package.json"
    pkg: dict | None = None
    if not pkg_path.is_file():
        record(
            "package.json",
            False,
            "package.json not found at repository root",
            "Add a root package.json with packageManager, husky, and standard scripts.",
        )
    else:
        try:
            loaded = json.loads(pkg_path.read_text(encoding="utf-8"))
            if isinstance(loaded, dict):
                pkg = loaded
                record("package.json", True, "ok")
            else:
                record(
                    "package.json",
                    False,
                    "package.json root must be a JSON object",
                    "Fix package.json syntax.",
                )
        except (OSError, ValueError) as exc:
            record(
                "package.json",
                False,
                f"invalid package.json: {exc}",
                "Fix package.json syntax.",
            )

    # 4. Pinned packageManager + matching lockfile
    manager: str | None = None
    if pkg is not None:
        pm = pkg.get("packageManager")
        if isinstance(pm, str) and PACKAGE_MANAGER_RE.match(pm.strip()):
            manager = pm.strip().split("@", 1)[0]
            lockfiles = MANAGER_LOCKFILES[manager]
            matched = next(
                (name for name in lockfiles if (repo / name).is_file() and (repo / name).stat().st_size > 0),
                None,
            )
            if matched:
                record("toolchain.package_manager", True, f"{pm.strip()} ({matched})")
            else:
                record(
                    "toolchain.package_manager",
                    False,
                    f"lockfile missing or empty for {manager} (expected {' or '.join(lockfiles)})",
                    f"Run `{manager} install` and commit the generated lockfile.",
                )
        else:
            record(
                "toolchain.package_manager",
                False,
                "package.json 'packageManager' must be pinned (e.g. pnpm@10.18.1)",
                'Set "packageManager": "<npm|pnpm|yarn|bun>@<x.y.z>" in package.json.',
            )

    # 5. Optional Node version pin (.nvmrc or .node-version)
    pin_file = next((p for p in (repo / ".nvmrc", repo / ".node-version") if p.is_file()), None)
    if pin_file is None:
        record("toolchain.node_pin", True, "no .nvmrc (using host PATH)")
    else:
        wanted = pin_file.read_text(encoding="utf-8").strip().lstrip("v")
        if not wanted:
            record(
                "toolchain.node_pin",
                False,
                f"{pin_file.name} is empty",
                f"Write a Node.js version (e.g. 22.23.4) in {pin_file.name}, or remove the file.",
            )
        else:
            found = find_node_version(wanted)
            if found:
                record("toolchain.node_pin", True, f"v{wanted} ({found})")
            else:
                record(
                    "toolchain.node_pin",
                    False,
                    f"{pin_file.name} pins Node v{wanted}, which is not installed locally",
                    f"Install Node v{wanted} (e.g. `nvm install {wanted}`).",
                )

    # 6. Required package.json scripts
    if pkg is not None:
        scripts = pkg.get("scripts")
        if not isinstance(scripts, dict):
            scripts = {}
        missing_scripts = []
        if str(scripts.get("prepare", "")).strip() != "husky":
            missing_scripts.append('prepare="husky"')
        for name in ("format:check", "lint", "test:unit", "test:e2e"):
            val = scripts.get(name)
            if not isinstance(val, str) or not val.strip():
                missing_scripts.append(name)
        if missing_scripts:
            record(
                "scripts.required",
                False,
                f"missing or invalid scripts: {', '.join(missing_scripts)}",
                'Define "prepare": "husky", "format:check", "lint", "test:unit", and "test:e2e" in package.json scripts.',
            )
        else:
            record("scripts.required", True, "ok")

    # 7. Husky installed & wired
    husky_problems: list[str] = []
    if pkg is not None:
        deps = {**(pkg.get("dependencies") or {}), **(pkg.get("devDependencies") or {})}
        if not isinstance(deps.get("husky"), str) or not deps["husky"].strip():
            husky_problems.append("husky not in package.json dependencies/devDependencies")
    _, hooks_path = git(repo, "config", "--get", "core.hooksPath")
    if hooks_path.rstrip("/") != ".husky/_":
        husky_problems.append(f"git core.hooksPath is {hooks_path!r} (expected '.husky/_')")
    if not (repo / ".husky" / "_" / "h").is_file():
        husky_problems.append(".husky/_/h missing (run `npx husky` or package install)")
    for hook in ("pre-commit", "commit-msg", "pre-push"):
        if not (repo / ".husky" / hook).is_file():
            husky_problems.append(f".husky/{hook} missing")
        shim = repo / ".husky" / "_" / hook
        if not (shim.is_file() and os.access(shim, os.X_OK)):
            husky_problems.append(f".husky/_/{hook} shim missing or not executable")
    if husky_problems:
        record(
            "husky.installed",
            False,
            "; ".join(husky_problems),
            "Install husky v9, run your package manager's install/prepare script so core.hooksPath=.husky/_, and add .husky/pre-commit, .husky/commit-msg, and .husky/pre-push.",
        )
    else:
        record("husky.installed", True, "ok")

    # 8. Husky pre-push delegation + no bypass indicators
    pre_push = repo / ".husky" / "pre-push"
    bypass_found = []
    for hook in ("pre-commit", "commit-msg", "pre-push"):
        hp = repo / ".husky" / hook
        if hp.is_file():
            text = hp.read_text(encoding="utf-8")
            if any(p.search(text) for p in DISABLE_PATTERNS):
                bypass_found.append(f".husky/{hook}")
    if bypass_found:
        record(
            "husky.pre_push",
            False,
            f"gate bypass indicator (--no-verify or HUSKY=0) found in {', '.join(bypass_found)}",
            "Remove --no-verify and HUSKY=0 from Husky hook files.",
        )
    elif not pre_push.is_file():
        record(
            "husky.pre_push",
            False,
            ".husky/pre-push missing",
            f'Create .husky/pre-push with: exec "{EXPECTED_DEPLOY_WRAPPER}"',
        )
    else:
        lines = effective_lines(pre_push)
        expected_line = f'exec "{EXPECTED_DEPLOY_WRAPPER}"'
        if lines != [expected_line]:
            record(
                "husky.pre_push",
                False,
                ".husky/pre-push does not delegate to the fleet ship-deploy wrapper",
                f'Set .husky/pre-push to a single effective line: {expected_line}',
            )
        else:
            record("husky.pre_push", True, "ok")

    # 9. Repo-owned non-production deploy entry point
    deploy_script = repo / "scripts" / "ship-deploy"
    if not (deploy_script.is_file() and os.access(deploy_script, os.X_OK)):
        record(
            "deploy.script",
            False,
            "executable scripts/ship-deploy not found at repository root",
            "Add an executable scripts/ship-deploy that takes <40-hex-SHA>, deploys it to non-production, and prints SHIP_DEPLOYED_SHA=<SHA> on stdout.",
        )
    else:
        record("deploy.script", True, "ok")

    return emit(repo, manager, checks, issues)


def emit(
    repo: Path,
    manager: str | None,
    checks: list[dict[str, object]],
    issues: list[dict[str, str]],
) -> int:
    ready = len(issues) == 0
    payload = {
        "status": "ready" if ready else "not_ready",
        "repo": str(repo),
        "package_manager": manager,
        "checks": checks,
        "issues": issues,
    }
    print(json.dumps(payload, indent=2))
    return 0 if ready else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

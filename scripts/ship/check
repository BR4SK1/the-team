def strip_jsonc(text: str) -> str:
    """Remove JSONC comments while preserving quoted strings and newlines."""
    output: list[str] = []
    in_string = False
    escaped = False
    index = 0
    while index < len(text):
        char = text[index]
        following = text[index + 1] if index + 1 < len(text) else ""
        if in_string:
            output.append(char)
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            index += 1
        elif char == '"':
            in_string = True
            output.append(char)
            index += 1
        elif char == "/" and following == "/":
            while index < len(text) and text[index] not in "\r\n":
                output.append(" ")
                index += 1
        elif char == "/" and following == "*":
            output.extend("  ")
            index += 2
            while index < len(text) and text[index : index + 2] != "*/":
                output.append("\n" if text[index] == "\n" else " ")
                index += 1
            if index >= len(text):
                raise ValueError("unterminated block comment")
            output.extend("  ")
            index += 2
        else:
            output.append(char)
            index += 1
    without_comments = "".join(output)
    # Trailing commas are removed outside quoted strings only; a comma
    # inside a string literal is content and must be preserved.
    result: list[str] = []
    in_string = False
    escaped = False
    index = 0
    while index < len(without_comments):
        char = without_comments[index]
        if in_string:
            result.append(char)
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            index += 1
        elif char == '"':
            in_string = True
            result.append(char)
            index += 1
        elif char == ",":
            lookahead = index + 1
            while (
                lookahead < len(without_comments)
                and without_comments[lookahead] in " \t\r\n"
            ):
                lookahead += 1
            if (
                lookahead < len(without_comments)
                and without_comments[lookahead] in "}]"
            ):
                result.append(" ")
            else:
                result.append(char)
            index += 1
        else:
            result.append(char)
            index += 1
    return "".join(result)



# Fleet ignore allowlist (deny-by-default): intended tracked assets are
# not ignored; private runtime siblings under fleet/ are ignored.
# git-only check on path names; no runtime file is read or created.
def is_ignored(path: str) -> bool:
    result = subprocess.run(
        ["git", "check-ignore", "--no-index", "-q", "--", path],
        capture_output=True,
    )
    return result.returncode == 0


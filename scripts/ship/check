#!/usr/bin/env bash
set -euo pipefail

# Local check runner for the-team (also invoked by .githooks/pre-commit).
repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$repo_root"

shellcheck -x -P SCRIPTDIR \
  .githooks/pre-commit \
  scripts/ship/check \
  scripts/ship/ship \
  scripts/ship/ship-deploy \
  scripts/ship/_node-env.sh

bash -n \
  .githooks/pre-commit \
  scripts/ship/check \
  scripts/ship/ship \
  scripts/ship/ship-deploy \
  scripts/ship/_node-env.sh

python3 -m unittest discover -s tests -p "*_test.py"

python3 - <<'PY'
import ast
import json
import re
import subprocess
from pathlib import Path


def strip_jsonc(text: str) -> str:
    """Remove JSONC comments and trailing commas outside quoted strings."""
    output: list[str] = []
    in_string = False
    escaped = False
    index = 0
    while index < len(text):
        char = text[index]
        following = text[index + 1] if index + 1 < len(text) else ""
        if in_string:
            output.append(char)
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            index += 1
        elif char == '"':
            in_string = True
            output.append(char)
            index += 1
        elif char == "/" and following == "/":
            while index < len(text) and text[index] not in "\r\n":
                output.append(" ")
                index += 1
        elif char == "/" and following == "*":
            output.extend("  ")
            index += 2
            while index < len(text) and text[index : index + 2] != "*/":
                output.append("\n" if text[index] == "\n" else " ")
                index += 1
            if index >= len(text):
                raise ValueError("unterminated block comment")
            output.extend("  ")
            index += 2
        else:
            output.append(char)
            index += 1
    without_comments = "".join(output)

    result: list[str] = []
    in_string = False
    escaped = False
    index = 0
    while index < len(without_comments):
        char = without_comments[index]
        if in_string:
            result.append(char)
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            index += 1
        elif char == '"':
            in_string = True
            result.append(char)
            index += 1
        elif char == ",":
            lookahead = index + 1
            while (
                lookahead < len(without_comments)
                and without_comments[lookahead] in " \t\r\n"
            ):
                lookahead += 1
            if (
                lookahead < len(without_comments)
                and without_comments[lookahead] in "}]"
            ):
                result.append(" ")
            else:
                result.append(char)
            index += 1
        else:
            result.append(char)
            index += 1
    return "".join(result)


# 1. Python syntax checks.
py_files = [Path("scripts/ship/ship-doctor"), *sorted(Path("tests").glob("*_test.py"))]
for path in py_files:
    ast.parse(path.read_text(encoding="utf-8"), filename=str(path))

# 2. Ship script executability & safety invariants.
for script in (
    Path("scripts/ship/check"),
    Path("scripts/ship/ship"),
    Path("scripts/ship/ship-doctor"),
    Path("scripts/ship/ship-deploy"),
):
    if not (script.is_file() and (script.stat().st_mode & 0o111)):
        raise ValueError(f"{script}: must exist and be executable")

ship_text = Path("scripts/ship/ship").read_text(encoding="utf-8")
for line in ship_text.splitlines():
    if "git -C" in line and " commit " in line and "--no-verify" in line:
        raise ValueError("scripts/ship/ship: must never pass --no-verify to git commit")
    if "git -C" in line and " push " in line and "$CANDIDATE:refs/heads/$TOPIC" not in line:
        raise ValueError("scripts/ship/ship: git push must pin $CANDIDATE:refs/heads/$TOPIC")

# 3. Ship skill frontmatter & no shell-interpolation markers.
ship_skill = Path("fleet/skills/ship/SKILL.md")
ship_skill_text = ship_skill.read_text(encoding="utf-8")
if not ship_skill_text.startswith("---\n") or "\n---\n" not in ship_skill_text[4:]:
    raise ValueError(f"{ship_skill}: frontmatter must be delimited by ---")
ship_frontmatter = ship_skill_text[4:].split("\n---\n", 1)[0]
if "opencode/autoinvoke: false" not in ship_frontmatter:
    raise ValueError(f"{ship_skill}: must set opencode/autoinvoke: false")
for marker in ("!`", "$(", "${"):
    if marker in ship_skill_text:
        raise ValueError(f"{ship_skill}: disallowed shell-interpolation marker {marker!r}")

# 4. Agent & skill frontmatter and env-read restoration checks.
def agent_permission_rules(text: str, name: str) -> list[dict[str, str]]:
    lines = text.splitlines()
    if not lines or lines[0] != "---" or "---" not in lines[1:]:
        raise ValueError(f"{name}: agent frontmatter must be delimited by ---")
    frontmatter = lines[1:lines.index("---", 1)]
    rules: list[dict[str, str]] = []
    current: dict[str, str] | None = None
    for line in frontmatter:
        item = re.match(r"\s*-\s*(\w+):\s*(.+?)\s*$", line)
        if item:
            if current:
                rules.append(current)
            current = {item.group(1): item.group(2).strip('"')}
            continue
        field = re.match(r"\s+(\w+):\s*(.+?)\s*$", line)
        if field and current:
            current[field.group(1)] = field.group(2).strip('"')
    if current:
        rules.append(current)
    return rules


def check_env_read_restore(name: str, rules: list[dict[str, str]]) -> None:
    read_all = any(
        rule.get("action") == "read"
        and rule.get("resource") == "*"
        and rule.get("effect") == "allow"
        for rule in rules
    )
    if read_all:
        for resource, effect in (
            ("*.env", "ask"),
            ("*.env.*", "ask"),
            ("*.env.example", "allow"),
        ):
            match = next(
                (
                    rule
                    for rule in rules
                    if rule.get("action") == "read"
                    and rule.get("resource") == resource
                ),
                None,
            )
            if not match or match.get("effect") != effect:
                raise ValueError(
                    f"{name}: agent read-all grant must restore base "
                    f"env-file rules ({resource}: {effect})"
                )


for path in sorted(Path("fleet/agents").glob("*.md")):
    check_env_read_restore(
        str(path),
        agent_permission_rules(path.read_text(encoding="utf-8"), str(path)),
    )

for skill_path in sorted(Path("fleet/skills").glob("*/SKILL.md")):
    skill_text = skill_path.read_text(encoding="utf-8")
    if not skill_text.startswith("---\n") or "\n---\n" not in skill_text[4:]:
        raise ValueError(f"{skill_path}: skill frontmatter must be delimited by ---")

web_prompt_skill = Path("fleet/skills/fleet-web-prompt-context/SKILL.md")
web_prompt_frontmatter = web_prompt_skill.read_text(encoding="utf-8")[4:].split("\n---\n", 1)[0]
for required in (
    "name: fleet-web-prompt-context",
    "metadata:",
    "  opencode/autoinvoke: false",
):
    if required not in web_prompt_frontmatter.splitlines():
        raise ValueError(f"{web_prompt_skill}: missing required frontmatter {required!r}")

# 5. fleet/opencode.jsonc privacy and structure checks.
fleet_text = Path("fleet/opencode.jsonc").read_text(encoding="utf-8")
fleet_config = json.loads(strip_jsonc(fleet_text))

for agent_name, agent in sorted((fleet_config.get("agents") or {}).items()):
    if not isinstance(agent, dict):
        continue
    permissions = agent.get("permissions") or []
    check_env_read_restore(
        f"fleet/opencode.jsonc#agents.{agent_name}",
        [
            {
                "action": rule.get("action", ""),
                "resource": str(rule.get("resource", "")),
                "effect": rule.get("effect", ""),
            }
            for rule in permissions
            if isinstance(rule, dict)
        ],
    )

if "instructions" in fleet_config:
    raise ValueError(
        "fleet/opencode.jsonc: must not set instructions; global "
        "AGENTS.md at the config root is loaded directly"
    )
if "__FLEET_HOST_" in fleet_text:
    raise ValueError("fleet/opencode.jsonc: must not contain generator host tokens")
if "/home/" in fleet_text:
    raise ValueError("fleet/opencode.jsonc: must not contain private home paths")
for url in re.findall(r"https?://[^\s\"']+", fleet_text):
    if url != "https://opencode.ai/config.json":
        raise ValueError(f"fleet/opencode.jsonc: disallowed literal URL {url!r}")
for alias, ref in (fleet_config.get("references") or {}).items():
    if isinstance(ref, dict) and not ref.get("path", "").startswith("{env:FLEET_HOME}"):
        raise ValueError(
            f"fleet/opencode.jsonc: references.{alias} path must be "
            "home-rooted via {env:FLEET_HOME}"
        )
if Path("fleet/opencode.json").exists():
    raise ValueError(
        "fleet/opencode.json: competing .json config; the single tracked "
        "config is fleet/opencode.jsonc"
    )

# 6. .gitignore allowlist under fleet/ (deny-by-default).
def is_ignored(path: str) -> bool:
    result = subprocess.run(
        ["git", "check-ignore", "--no-index", "-q", "--", path],
        capture_output=True,
    )
    return result.returncode == 0


for allowed in (
    "fleet/opencode.jsonc",
    "fleet/AGENTS.md",
    "fleet/agents/cal.md",
    "fleet/agents/new-agent.md",
    "fleet/skills/cad/SKILL.md",
    "fleet/skills/new-skill/SKILL.md",
    "fleet/skills/ship/SKILL.md",
    "fleet/skills/ship/resources/PR_TEMPLATE.md",
):
    if is_ignored(allowed):
        raise ValueError(
            f".gitignore: intended fleet asset {allowed!r} must not be ignored"
        )
for denied in (
    "fleet/service.json",
    "fleet/cli.json",
    "fleet/opencode.json",
    "fleet/auth.json",
    "fleet/foo.env",
    "fleet/dump.log",
    "fleet/random.txt",
    "fleet/agents/private.json",
    "fleet/commands/private.json",
    "fleet/skills/cad/extra.json",
    "fleet/skills/cad/notes.md",
    "fleet/plugin/file.js",
    "fleet/plugins/private.ts",
    "fleet/skills/ship/resources/extra.txt",
):
    if not is_ignored(denied):
        raise ValueError(
            f".gitignore: runtime file {denied!r} under fleet/ must be ignored"
        )

# 7. Parse all JSON and JSONC files in repo.
for path in sorted(Path(".").glob("**/*.json")):
    if ".git" not in path.parts:
        json.loads(path.read_text(encoding="utf-8"))

for path in sorted(Path(".").glob("**/*.jsonc")):
    if ".git" not in path.parts:
        json.loads(strip_jsonc(path.read_text(encoding="utf-8")))

print("All checks passed.")
PY
